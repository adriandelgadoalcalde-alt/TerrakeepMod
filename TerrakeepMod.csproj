<Project Sdk="Microsoft.NET.Sdk">

	<!-- Propiedades de mod de tModLoader. Este .targets es el generico que tModLoader deja en
	     ModSources\ y que a su vez importa el real de la instalacion del juego
	     ("C:\Program Files (x86)\Steam\steamapps\common\tModLoader\tMLMod.targets"), del que
	     salen TargetFramework=net8.0, LangVersion=12.0, las referencias a tModLoader.dll y a
	     Libraries\, y el target BuildMod que genera el .tmod. -->
	<Import Project="..\tModLoader.targets" />

	<PropertyGroup>
		<AssemblyName>TerrakeepMod</AssemblyName>
		<RootNamespace>TerrakeepMod</RootNamespace>
		<!-- Los mismos valores que ya fija tMLMod.targets. Se repiten aqui a proposito porque
		     alli van dentro de <PropertyGroup Condition="'$(BuildMod)' == 'true'">, asi que al
		     compilar con -p:BuildMod=false (lo que hace scripts\compilar.ps1 en su primera fase,
		     para validar el C# sin lanzar el empaquetado del .tmod) el proyecto se quedaba sin
		     TargetFramework y el SDK abortaba con NETSDK1013. Si algun dia tModLoader cambia de
		     runtime, estos dos valores hay que actualizarlos junto con el TargetFrameworks de
		     Terrakeep.Core. -->
		<TargetFramework>net8.0</TargetFramework>
		<LangVersion>12.0</LangVersion>
		<!-- A proposito NO se activan ImplicitUsings ni Nullable: tModLoader NO compila el mod
		     con MSBuild, lo compila el mismo con Roslyn desde ModCompile.RoslynCompile (ver el
		     codigo real en tModLoader-Decompiled\tModLoader\Terraria\ModLoader\Core\
		     ModCompile.cs), y ahi las opciones estan fijadas en el codigo: NullableContextOptions
		     = Disable y sin usings implicitos. Si se activasen aqui, el proyecto compilaria en
		     Visual Studio / dotnet build pero fallaria al generar el .tmod de verdad. Todos los
		     using van explicitos en cada archivo. -->
	</PropertyGroup>

	<!-- KeepQA (17-sep-2026, mismo patron ya probado esta misma noche en el repo hermano
	     TModLoaderMod): TerrakeepMod.Tests\ y TerrakeepMod.LogicaPura\ (arnes de pruebas nuevo, ver
	     bitacora.md) viven DENTRO de esta misma carpeta de mod - sin este Remove, el glob implicito
	     "**/*.cs" del SDK se traga tambien sus .cs (fuente Y generados en su bin/obj), provocando
	     referencias a Xunit/CsCheck que este proyecto no tiene y atributos de ensamblado duplicados
	     (confirmado en vivo: CS0246/CS0579 antes de este Remove). Esto protege solo "dotnet
	     build"/el IDE - el -build REAL de tModLoader ignora el .csproj por completo y se protege
	     aparte con build.txt/buildIgnore (ver ese archivo). -->
	<ItemGroup>
		<Compile Remove="TerrakeepMod.Tests\**\*.cs" />
		<Compile Remove="TerrakeepMod.LogicaPura\**\*.cs" />
	</ItemGroup>

	<ItemGroup>
		<!-- Terrakeep.Core compilado para net8.0 (repo hermano Terrasavr-Native). Esta
		     referencia es solo para que compile MSBuild / el IDE; el compilador propio de
		     tModLoader resuelve el mismo DLL por su cuenta a partir de "dllReferences" en
		     build.txt. Private=false para no copiarlo a bin\ (el que cuenta es el de lib\). -->
		<Reference Include="Terrakeep.Core">
			<HintPath>lib\Terrakeep.Core.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<!-- KeepQA (17-sep-2026): mismo trio de analizadores externos ya integrado en Terrakeep.Core,
	     Starvekeep.Core, ServidorKeep.Core y Keep.Wpf - analizadores de .NET de serie (ya vienen
	     con el SDK) + Roslynator.Analyzers como segunda pasada de reglas independiente. Solo
	     AFECTA a "dotnet build"/el IDE: el compilador REAL de tModLoader (ModCompile.RoslynCompile,
	     invocado por el target BuildMod de tMLMod.targets) nunca ejecuta analizadores de MSBuild
	     ni lee PackageReference - solo compila los .cs y resuelve "dllReferences" de build.txt -
	     asi que esto no puede romper el .tmod real, solo el "dotnet build" de validacion (fase 1
	     de scripts\compilar.ps1) y la experiencia en el IDE. Verificado: el mod sigue compilando y
	     empaquetando igual tras añadir esto (ver bitacora.md). -->
	<PropertyGroup>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>latest</AnalysisLevel>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Roslynator.Analyzers" Version="5.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
