{
  "stryker-config": {
    "project": "TerrakeepMod.LogicaPura.csproj",
    "target-framework": "net10.0",
    "mutate": [
      "**/GramaticaBusqueda.cs",
      "!**/obj/**/*.cs",
      "!**/bin/**/*.cs"
