Panel: {
	Titulo: Terrakeep
	Cerrar: Close ({0})
	Atajo: Shortcut: {0}

	Area: {
		Personaje: Character
		Libreria: Library
		Builds: Builds
		Investigacion: Research
		Exploracion: Exploration
		Ajustes: Settings
		Guia: Guide
	}

	Ayuda: {
		Personaje: Everything you touch here is written straight to the loaded character.
		Libreria: Grab items from the catalogue with the mouse and drop them into any real container.
		Builds: Moves what you own; pulls the rest from the catalogue and places it too.
		Investigacion: It writes through Journey Mode's official API, so the game's own menu shows the same.
		Exploracion: Drag the mini-map to pan and use the wheel to zoom.
		Ajustes: The language changes live. Ctrl+Z undoes any Terrakeep action.
		Guia: Tells you what to do now and why, reading your real character. Direction, never coordinates.
	}
}

Personaje: {
	Pestana: {
		Inventario: Inventory
		Almacenes: Storage
		Equipo: Equipment
		Buffs: Buffs
		Apariencia: Appearance
		Desbloqueos: Unlocks
	}

	Nombre: Name
	SinNombre: (no name)
	VidaMaxima: Max health
	ManaMaximo: Max mana
	VidaEfectiva: "{0} (effective {1})"
	ManaEfectivo: "{0} (effective {1})"
	Ahora: Now: {0}/{1} health, {2}/{3} mana
	Llenar: Refill health and mana
	Dinero: Money: {0}  (inventory {1} | storage {2})

	Moneda: {
		Platino: plat
		Oro: gold
		Plata: silver
		Cobre: copper
	}

	Inventario: {
		Mochila: Backpack - 50 slots (Player.inventory[0..49])
		Monedas: Coins (50-53)
		Municion: Ammo (54-57)
		Nota: Drag, stack and right-click exactly like in the game's inventory: it is vanilla's own ItemSlot.
		Ocupacion: Backpack: {0} of {1} slots in use.
	}

	Almacenes: {
		Nombre: {
			Hucha: Piggy Bank
			Caja: Safe
			Forja: Defender's Forge
			Boveda: Void Vault
		}

		Titulo: "{0} - {1} slots (Player.{2}.item)"
		Ocupacion: "{0}: {1} of {2} slots in use."
	}

	Equipo: {
		Conjunto: Equipment loadout
		ConjuntoN: Loadout {0}
		Nota: The active loadout lives in Player.armor/dye; switching uses Player.TrySwitchingLoadout (it does not work while dead or using an item).
		Equipado: Worn
		Vanidad: Vanity
		Tinte: Dye
		Cabeza: Head
		Pecho: Chest
		Piernas: Legs
		Accesorio: Accessory {0}
		NoActiva: "{0}  (inactive)"
		Especial: Special equipment
		Puesto: Equipped

		Misc: {
			Mascota: Pet
			MascotaLuz: Light pet
			Vagoneta: Minecart
			Montura: Mount
			Gancho: Grappling hook
		}

		RanurasActivas: Active accessory slots: {0} of 7
		Leyenda: Columns: worn · vanity · dye
		LeyendaMisc: Columns: equipped · dye
	}

	Herramientas: {
		Papelera: Trash
		CantidadObjetivo: Quantity of "{0}" ({1}/{2}):
		CantidadSinObjetivo: Quantity: hover an item with more than 1 unit
		CantidadPista: quantity
		CantidadAplicar: Apply
		CantidadAyuda: Type a number and press Apply (or Enter), or use - / +. The limit is the item's real maximum.
		CantidadHistorial: Quantity of "{0}": {1} -> {2}
	}

	Buffs: {
		Activos: Active buffs: {0} of {1} slots
		QuitarTodos: Remove all
		Quitar: Remove
		NombreConId: "{0}  (id {1})"
		Permanente: permanent
		HorasMinutos: "{0} h {1} min"
		Anadir: Add a buff
		Buscar: Search
		PistaBusqueda: buff name or id
		Segundos: Seconds
		Nota: Applied with Player.AddBuff (the official API): it respects immunities and limits.
		SinResultados: No results.
		Aplicar: Apply

		Arbol: {
			Inicio: Home
			InicioAyuda: Back to the top-level folders
			Subir: < Up
			SubirAyuda: Go up one folder
			Raiz: Buffs
			SinSubcarpetas:
				'''
				This folder has no subfolders.
				Its buffs are on the right.
				'''
