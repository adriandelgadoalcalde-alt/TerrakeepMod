Panel: {
	Titulo: Terrakeep
	Cerrar: Close ({0})
	Atajo: Shortcut: {0}

	Area: {
		Personaje: Character
		Libreria: Library
		Builds: Builds
		Investigacion: Research
		Exploracion: Exploration
		Ajustes: Settings
	}

	Ayuda: {
		Personaje: Everything you touch here is written straight to the loaded character.
		Libreria: Grab items from the catalogue with the mouse and drop them into any real container.
		Builds: Auto-equip only MOVES what you already have: it never creates items.
		Investigacion: It writes through Journey Mode's official API, so the game's own menu shows the same.
		Exploracion: Drag the mini-map to pan and use the wheel to zoom.
		Ajustes: The language changes live. Ctrl+Z undoes any Terrakeep action.
	}
}

Personaje: {
	Pestana: {
		Inventario: Inventory
		Almacenes: Storage
		Equipo: Equipment
		Buffs: Buffs
		Apariencia: Appearance
		Desbloqueos: Unlocks
	}

	Nombre: Name
	SinNombre: (no name)
	VidaMaxima: Max health
	ManaMaximo: Max mana
	VidaEfectiva: "{0} (effective {1})"
	ManaEfectivo: "{0} (effective {1})"
	Ahora: Now: {0}/{1} health, {2}/{3} mana
	Llenar: Refill health and mana
	Dinero: Money: {0}  (inventory {1} | storage {2})

	Moneda: {
		Platino: plat
		Oro: gold
		Plata: silver
		Cobre: copper
	}

	Inventario: {
		Mochila: Backpack - 50 slots (Player.inventory[0..49])
		Monedas: Coins (50-53)
		Municion: Ammo (54-57)
		Nota: Drag, stack and right-click exactly like in the game's inventory: it is vanilla's own ItemSlot.
		Ocupacion: Backpack: {0} of {1} slots in use.
	}

	Almacenes: {
		Nombre: {
			Hucha: Piggy Bank
			Caja: Safe
			Forja: Defender's Forge
			Boveda: Void Vault
		}

		Titulo: "{0} - {1} slots (Player.{2}.item)"
		Ocupacion: "{0}: {1} of {2} slots in use."
	}

	Equipo: {
		Conjunto: Equipment loadout
		ConjuntoN: Loadout {0}
		Nota: The active loadout lives in Player.armor/dye; switching uses Player.TrySwitchingLoadout (it does not work while dead or using an item).
		Equipado: Worn
		Vanidad: Vanity
		Tinte: Dye
		Cabeza: Head
		Pecho: Chest
		Piernas: Legs
		Accesorio: Accessory {0}
		NoActiva: "{0}  (inactive)"
		Especial: Special equipment
		Puesto: Equipped

		Misc: {
			Mascota: Pet
			MascotaLuz: Light pet
			Vagoneta: Minecart
			Montura: Mount
			Gancho: Grappling hook
		}

		RanurasActivas: Active accessory slots: {0} of 7
		Leyenda: Columns: worn · vanity · dye
		LeyendaMisc: Columns: equipped · dye
	}

	Herramientas: {
		Papelera: Trash
		CantidadObjetivo: Quantity of "{0}" ({1}/{2}):
		CantidadSinObjetivo: Quantity: hover an item with more than 1 unit
		CantidadPista: quantity
		CantidadAplicar: Apply
		CantidadAyuda: Type a number and press Apply (or Enter), or use - / +. The limit is the item's real maximum.
		CantidadHistorial: Quantity of "{0}": {1} -> {2}
	}

	Buffs: {
		Activos: Active buffs: {0} of {1} slots
		QuitarTodos: Remove all
		Quitar: Remove
		NombreConId: "{0}  (id {1})"
		Permanente: permanent
		HorasMinutos: "{0} h {1} min"
		Anadir: Add a buff
		Buscar: Search
		PistaBusqueda: buff name or id
		Segundos: Seconds
		Nota: Applied with Player.AddBuff (the official API): it respects immunities and limits.
		SinResultados: No results.
		Aplicar: Apply

		Arbol: {
			Inicio: Home
			InicioAyuda: Back to the top-level folders
			Subir: < Up
			SubirAyuda: Go up one folder
			Raiz: Buffs
			SinSubcarpetas:
				'''
				This folder has no subfolders.
				Its buffs are on the right.
				'''
			CarpetaBuffs:
				'''
				{0}
				{1} buffs
				'''
			CarpetaConSubcarpetas:
				'''
				{0}
				{1} buffs, {2} subfolders
				'''
			CarpetaDeMod: "{0} (mod)"
			Otros: Other
			Pagina: Page {0}
			Cargando: Loading the buffs...
			EnCarpeta: in "{0}"
			EnTodo: across all applicable buffs
			ElegirCarpeta: "{0} applicable buffs. Pick a folder or search."
			MostrandoParcial: Showing {0} of {1} {2}.
			MostrandoTodos: "{0} buffs {1}."
		}
	}

	Apariencia: {
		Peinado: Hairstyle
		PeinadoValor: "{0} of {1}"
		VarianteEtiqueta: Variant / gender
		Variante: "{0} - {1}"
		VarianteDesconocida: Variant {0}

		Genero: {
			Hombre: Male
			Mujer: Female
		}

		Atuendo: {
			Inicial: starter
			Pegatina: sticker
			Gangster: gangster
			Abrigo: coat
			Vestido: dress
			Maniqui: display doll
		}

		Tinte: Hair dye
		SinTinte: None
		TinteDesconocido: shader {0} (unknown)
		NotaTintes: Hair dyes found in the game (mods included): {0}, taken from Item.hairDye in ContentSamples.
		Colores: Colours

		Canal: {
			Rojo: R
			Verde: G
			Azul: B
		}

		Color: {
			Pelo: Hair
			Piel: Skin
			Ojos: Eyes
			Camisa: Shirt
			CamisetaInterior: Undershirt
			Pantalones: Trousers
			Zapatos: Shoes
		}

		NotaColores: Changes show on the character right away: the game draws it from these very fields.
	}

	Desbloqueos: {
		Titulo: "{0} permanent unlocks. They are written straight to Main.LocalPlayer."
		Nota: Hover a checkbox to see the real Player field it writes and its conditions.

		extraAccessory: {
			Nombre: 6th accessory slot
			Descripcion: Demon Heart. It only takes effect in Expert mode or above.
		}

		unlockedBiomeTorches: {
			Nombre: Biome torches unlocked
			Descripcion: Torch God's Favor. Without it, the checkbox below does nothing.
		}

		UsingBiomeTorches: {
			Nombre: Biome torches turned on
			Descripcion: A property: it stores into builderAccStatus[11] and needs the unlock above.
		}

		ateArtisanBread: {
			Nombre: Artisan Loaf eaten
			Descripcion: Artisan Loaf: lets you craft near any station.
		}

		usedAegisCrystal: {
			Nombre: Aegis Crystal used
			Descripcion: Aegis Crystal: permanent +defence.
		}

		usedAegisFruit: {
			Nombre: Aegis Fruit used
			Descripcion: Aegis Fruit: permanent +life.
		}

		usedArcaneCrystal: {
			Nombre: Arcane Crystal used
			Descripcion: Arcane Crystal: permanent +mana regeneration.
		}

		usedGalaxyPearl: {
			Nombre: Galaxy Pearl used
			Descripcion: Galaxy Pearl: permanent +luck.
		}

		usedGummyWorm: {
			Nombre: Gummy Worm used
			Descripcion: Gummy Worm: permanent +fishing.
		}

		usedAmbrosia: {
			Nombre: Ambrosia used
			Descripcion: Ambrosia: permanent +mining and gathering speed.
		}

		downedDD2EventAnyDifficulty: {
			Nombre: DD2 event beaten
			Descripcion: Old One's Army beaten at least once, at any difficulty.
		}

		unlockedSuperCart: {
			Nombre: Mechanical Cart unlocked
			Descripcion: Mechanical Cart: a permanent minecart upgrade.
		}

		enabledSuperCart: {
			Nombre: Mechanical Cart turned on
			Descripcion: Needs the unlock above (Player.UsingSuperCart checks both).
		}
	}
}

