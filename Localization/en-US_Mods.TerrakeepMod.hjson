Exploracion: {
	Titulo: World exploration
	LineaMundo: '''"{0}"  ·  {1}  ·  {2}'''
	Hardmode: Hardmode
	PreHardmode: Pre-Hardmode
	Explorado: Explored: {0} %
	EstasEn: You are at tile {0}
	MapaListo: Game map ready
	MapaSinGenerar: The game map has not been generated yet

	Pestana: {
		Mapa: Map
		Busqueda: Search
		Mundo: This world
		Vecindad: Neighbourhood
		Rebobinar: Rewind
	}

	// Functions catalogue idea 5 ("NPC happiness planner").
	Vecindad: {
		Titulo: Neighborhood
		Resumen: "{0} town NPCs active right now."
		Ninguno: You don't have any town NPCs living in this world yet.
		Precio: "{0} % of the base price"
		SinInforme: (nothing special to say - content by default)
		SinCasa: No house assigned - their mood isn't reliable until they have one.
		Lejos: "{0} tiles away - get closer to their house for a real reading (this report may be reading your current biome, not theirs)."
		MarcarEnMapa: Mark houses on map
		MarcarEnMapaAyuda: Paints a real marker on each neighbor's house (NPC.homeTileX/homeTileY) on the minimap and the game's map.
	}

	// Functions catalogue idea 10 ("rewind the world"): a terrain undo, same idea as the object
	// undo history but for a bounded square of tiles around the player.
	Rebobinar: {
		Titulo: Rewind the terrain
		Explicacion: Mark a real snapshot of the terrain in a {0}x{0}-tile square around you (blocks, walls, liquids, slopes, paint and wires) and bring it back exactly as it was whenever you want.
		SoloUnJugador: Only available in singleplayer games (does not sync changes to other connected players yet).
		Marcar: Mark here
		Rebobinar: Rewind now
		SinMarcar: You haven't marked a spot yet.
