		}

		usedArcaneCrystal: {
			Nombre: Arcane Crystal used
			Descripcion: Arcane Crystal: permanent +mana regeneration.
		}

		usedGalaxyPearl: {
			Nombre: Galaxy Pearl used
			Descripcion: Galaxy Pearl: permanent +luck.
		}

		usedGummyWorm: {
			Nombre: Gummy Worm used
			Descripcion: Gummy Worm: permanent +fishing.
		}

		usedAmbrosia: {
			Nombre: Ambrosia used
			Descripcion: Ambrosia: permanent +mining and gathering speed.
		}

		downedDD2EventAnyDifficulty: {
			Nombre: DD2 event beaten
			Descripcion: Old One's Army beaten at least once, at any difficulty.
		}

		unlockedSuperCart: {
			Nombre: Mechanical Cart unlocked
			Descripcion: Mechanical Cart: a permanent minecart upgrade.
		}

		enabledSuperCart: {
			Nombre: Mechanical Cart turned on
			Descripcion: Needs the unlock above (Player.UsingSuperCart checks both).
		}
	}
}

