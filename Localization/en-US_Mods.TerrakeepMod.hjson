			LargoElegido: Chosen world chest: {0}
		}
	}

	// Function catalogue idea 6: SelectorCofreMundoTk's dropdown list with EVERY real chest
	// placed in the loaded world, to pick one as a Library destination.
	SelectorCofre: {
		SoloUnJugador: Only available in singleplayer games (does not sync changes to other connected players yet).
		Resumen: "{0} real chests found in this world."
		Ninguno: This world does not have any chest placed yet.
		NingunoConBusqueda: No real chest has an item matching the search.
		MasCofres: … and {0} more, farther away (get closer to see them at the top).
		SinNombre: Unnamed chest at ({0}, {1})
		ConNombre: "{0} at ({1}, {2})"
		Fila: "{0}  ·  {1} tiles  ·  {2}/{3} items"
		Ayuda: Real position: ({0}, {1}). {2} tiles away from you right now.
		PistaBusqueda: search by item inside…
		OrdenDistancia: Sort: distance
		OrdenNombre: Sort: name
		OrdenLlenos: Sort: full first
		OrdenAyuda: Click to change the list order (distance → name → full first, grouping empty ones last).
		Traer: → Inventory
		TraerAyuda: Brings {0} straight to your real inventory, without changing destination.
		TraerDeshacer: Bring {0} from the world chest to the inventory
	}

	Herramientas.Titulo: Edit item

	EditorPrefijo: {
		RecuadroTitulo: Select
		RecuadroPista: drag here
		BotonSinObjetivo: Prefix: (nothing selected)
		Boton: Prefix: {0}
		Ayuda: Pick a legal prefix for the item in the selection box.
		Historial: Prefix of "{0}": {1} -> {2}
	}

	EditorCantidad: {
		SinSeleccion: Quantity: drag an item into the box above
		NoApilable: '''"{0}" does not stack (its quantity cannot be edited)'''
	}

	// Visual redesign catalogue TM2 ("Floating item editor").
	TarjetaFlotante: {
		Prefijo: Prefix: {0}
		PrefijoConMejor: Prefix: {0}  ·  best: {1}
	}

	Prefijo: {
		Ninguno: None

		Stat: {
			Damage: damage
			CritChance: critical strike chance
			Knockback: knockback
			UseTime: use time
			Size: size
			ShootSpeed: shot speed
			ManaCost: mana cost
			Defense: defense
			MaxMana: max mana
			MoveSpeed: movement speed
			MeleeSpeed: melee speed
		}
	}
}

Builds: {
	AutoEquipar: Auto-equip
	AutoEquiparAyuda: Puts this build's gear into place. What you already own gets MOVED; what you don't gets PULLED from the catalogue (with its best prefix) and placed the same way.
	SinCatalogo: No build catalogue is loaded.
	Armadura: Armour
	Armas: Weapons
	Accesorios: Accessories
	PrefijoSugerido: suggested prefix: {0}
	NoExisteAqui: does not exist in this game
	Nada: (nothing)
	// Visual redesign catalogue TM5: now the whole subtitle text (the "Tienes X de Y" count moved
	// to the progress ring) - a complete sentence with its own capital letter and period.
	RanurasAccesorio: Accessory slots available: {0}.
	Leyenda: Green = you have it  ·  grey = you do not  ·  red = it does not exist here.
	ResultadoAutoEquipar: Auto-equip: {0}
	NadaQueMover: Nothing was applied: no item from this build exists in this game (the source mod isn't installed).
	Resumen: moved={0}, already in place={1}, created={2}, no room={3}, not in this game={4}
	SinSitioDetalle: No room: {0}.
	SinSitioItem: "{0}: {1}"

	CausaSinSitio: {
		MochilaLlena: the backpack is full
		SlotAccesorio: there's no free accessory slot for it (or it clashes with what you already have equipped)
		NoArmadura: it isn't a recognisable armour piece
	}

	Etapa: {
		vanilla: {
			prehardmode: Pre-Hardmode (ready for the Wall of Flesh)
			earlyhardmode: Early Hardmode (before the mechanical bosses)
			endgame: Endgame (post Lunatic Cultist / Moon Lord)
		}

		calamity: {
			prehardmode: Pre-Hardmode (ready for the Wall of Flesh)
			earlyhardmode: Hardmode (post-Plantera / pre-Golem, roughly)
			endgame: Endgame (Auric Tesla, post-Yharon/Exo Mechs)
		}
	}

	Clase: {
		Melee: Melee
		Ranged: Ranged
		Mage: Mage
		Summoner: Summoner
		Rogue: Rogue
	}

	ConjuntoDestinoPildora: Set {0}
	ConjuntoDestinoAyuda: Which of the three equipment sets (1/2/3) this build's armour and accessories go to on auto-equip.
	ConjuntoActivoMarca: (active)

	// Functions catalogue idea 7: in-game build codes (TKBUILD1:...).
	Codigo: {
		Pista: TKBUILD1:... code
		Exportar: Export
		ExportarAyuda: Copies the chosen equipment set (armour, accessories and dyes) as a code and puts it on the clipboard.
		Importar: Import
		ImportarAyuda: Applies the code in the text box to the chosen equipment set. What you already own is moved; what you don't is created (dyes are never created).
		Copiado: Code copied to the clipboard ({0} of 10 slots encoded).
		CopiadoConOmitidos: Code copied to the clipboard ({0} of 10 slots encoded, {1} modded item(s) skipped - no id catalogue yet, real limit, see the log).
		Resultado: Code applied: created={0}, moved={1}, already set={2}, no room={3}, dyes moved={4}, unrecognised id={5}.
		ErrorFormato: The text in the box is not a valid TKBUILD1 code.
		ErrorCorrupto: The code is damaged or incomplete (its internal checksum doesn't match).
		ErrorVersion: The code is from a newer TKBUILD version than this one.
		SlotNoDesbloqueado: your character hasn't unlocked that accessory slot yet
		IdNoReconocido: doesn't exist in this game version/mod list
		PrefijoDistinto: your real prefix is different from the one the code carried
		MochilaLlena: it was about to be created, but there was no room in the backpack for what you already had there

		Slot: {
			Cabeza: Helmet
			Cuerpo: Chestplate
			Piernas: Leggings
			Accesorio1: Accessory 1
			Accesorio2: Accessory 2
			Accesorio3: Accessory 3
			Accesorio4: Accessory 4
			Accesorio5: Accessory 5
			Accesorio6: Accessory 6
			Accesorio7: Accessory 7
		}
	}
}

Investigacion: {
	ProgresoGlobal: Overall progress
