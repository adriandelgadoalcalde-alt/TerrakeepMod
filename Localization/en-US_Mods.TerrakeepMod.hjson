Keybinds: {
	AbrirPanel.DisplayName: Open Terrakeep
	# WS4 - builds and auto-equip.
	AbrirBuilds.DisplayName: Open Terrakeep Builds
	# WS7 - settings and undo/redo history.
	AbrirAjustes.DisplayName: Open Terrakeep Settings
	Deshacer.DisplayName: Undo (hold Ctrl)
	Rehacer.DisplayName: Redo (hold Ctrl)
}

Configs: {
	AjustesConfig: {
		DisplayName: Terrakeep Settings

		Idioma: {
			Label: Interface language
			Tooltip: Which language Terrakeep uses for its panels. Picking Spanish or English switches the whole game's language right away, because tModLoader only has one active language at a time.
		}

		AtajosYaSembrados: {
			Label: Atajos Ya Sembrados
			Tooltip: ""
		}
	}

	IdiomaDeTerrakeep: {
		SeguirElJuego: {
			Label: Follow the game
			Tooltip: ""
		}

		Espanol: {
			Label: Spanish
			Tooltip: ""
		}

		English: {
			Label: English
			Tooltip: ""
		}

		Tooltip: ""
	}
}

Ajustes: {
	Titulo: Terrakeep - Settings
	Idioma: Interface language
	IdiomaSeguirElJuego: Follow the game
	IdiomaEspanol: Spanish
	IdiomaIngles: English
	CulturaActiva: Game language in use right now: {0}
	Cerrar: Close
	Historial: Undo and redo
	HistorialVacio: Nothing in this session's history yet.
	HistorialEntradas: Actions stored in the history: {0}
	Deshacer: Undo (Ctrl+Z)
	Rehacer: Redo (Ctrl+Y)
	DeshacerAlgo: Undo: {0}
	RehacerAlgo: Redo: {0}
}

Historial: {
	Deshecho: Terrakeep undid: {0}
	Rehecho: Terrakeep redid: {0}
	NadaQueDeshacer: Terrakeep has nothing to undo.
	NadaQueRehacer: Terrakeep has nothing to redo.
}
