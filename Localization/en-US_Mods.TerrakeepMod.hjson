			Gancho: Grappling hook
		}

		RanurasActivas: Active accessory slots: {0} of 7
		Leyenda: Columns: worn · vanity · dye
		LeyendaMisc: Columns: equipped · dye
	}

	Conjuntos: {
		TituloNativos: The game's three loadouts
		IrAyuda: Switch to this loadout (Player.TrySwitchingLoadout).
		Renombrar: Rename
		TituloPresets: Saved presets (no limit)
		SinPresets: No presets saved yet. Use "Save active loadout" below.
		Aplicar: Apply
		AplicarAyuda: Writes this preset over the CURRENTLY active loadout (armor, vanity, dyes). Undoable with Ctrl+Z.
		Borrar: Delete
		NombreNuevo: Save active loadout as preset:
		NombrePista: preset name
		NombreSinTitulo: Untitled
		GuardarNuevo: Save new preset
		GuardarNuevoAyuda: Snapshots armor, vanity and dyes of the CURRENTLY active loadout into a new preset with this name.
		HistorialAplicar: Apply preset "{0}"
	}

	Herramientas: {
		Papelera: Trash
		CantidadObjetivo: Quantity of "{0}" ({1}/{2}):
		CantidadSinObjetivo: Quantity: hover an item with more than 1 unit
		CantidadPista: quantity
		CantidadAplicar: Apply
		CantidadAyuda: Type a number and press Apply (or Enter), or use - / +. The limit is the item's real maximum.
		CantidadHistorial: Quantity of "{0}": {1} -> {2}
	}

	Buffs: {
		Activos: Active buffs: {0} of {1} slots
		QuitarTodos: Remove all
		Quitar: Remove
		NombreConId: "{0}  (id {1})"
		Permanente: permanent
		HorasMinutos: "{0} h {1} min"
		Anadir: Add a buff
		Buscar: Search
		PistaBusqueda: buff name or id
		Segundos: Seconds
		Nota: Applied with Player.AddBuff (the official API): it respects immunities and limits.
		SinResultados: No results.
		Aplicar: Apply

		Arbol: {
			Inicio: Home
			InicioAyuda: Back to the top-level folders
