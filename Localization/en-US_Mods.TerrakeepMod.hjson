Builds: {
	AutoEquipar: Auto-equip
	AutoEquiparAyuda: Puts the gear from this build that you ALREADY own into place. It never creates items: what you lack stays as it is.
	SinCatalogo: No build catalogue is loaded.
	Armadura: Armour
	Armas: Weapons
	Accesorios: Accessories
	PrefijoSugerido: suggested prefix: {0}
	NoExisteAqui: does not exist in this game
	Nada: (nothing)
	RanurasAccesorio: accessory slots available: {0}
	Tienes: You have {0} of {1} items from this build{2}.
	Leyenda: Green = you have it  ·  grey = you do not  ·  red = it does not exist here.
	ResultadoAutoEquipar: Auto-equip: {0}
	NadaQueMover: You didn't own any item from this build to move. Auto-equip only moves what you already own, never creates anything.
	Resumen: moved={0}, already in place={1}, not owned={2}, no room={3}, not in this game={4}

	Etapa: {
		vanilla: {
			prehardmode: Pre-Hardmode (ready for the Wall of Flesh)
			earlyhardmode: Early Hardmode (before the mechanical bosses)
			endgame: Endgame (post Lunatic Cultist / Moon Lord)
		}

		calamity: {
			prehardmode: Pre-Hardmode (ready for the Wall of Flesh)
			earlyhardmode: Hardmode (post-Plantera / pre-Golem, roughly)
			endgame: Endgame (Auric Tesla, post-Yharon/Exo Mechs)
		}
	}

	Clase: {
		Melee: Melee
		Ranged: Ranged
		Mage: Mage
		Summoner: Summoner
		Rogue: Rogue
	}

	ConjuntoDestinoPildora: Set {0}
	ConjuntoDestinoAyuda: Which of the three equipment sets (1/2/3) this build's armour and accessories go to on auto-equip.
	ConjuntoActivoMarca: (active)
}

Investigacion: {
	ProgresoGlobal: Overall progress
	Progreso: "{0} / {1} items ({2}%)"
	AvisoNoViaje: WARNING: this is not a Journey Mode character (difficulty {0}): it is saved, but the game ignores it.
	EligeCarpeta: Pick a folder
	InvestigarCarpeta: Research folder
	InvestigarCarpetaAyuda: Fully researches every item in this folder and the ones inside it
	QuitarCarpeta: Clear folder
	QuitarCarpetaAyuda: Un-researches everything in this folder (Ctrl+Z brings it back)
	SoloFalta: Only what is missing
	SoloFaltaAyuda: Hides items that are already fully researched
	InvestigarTodo: Research EVERYTHING
	InvestigarTodoAyuda: Fully researches EVERY researchable item in the game
	QuitarTodo: Clear ALL research
	QuitarTodoAyuda: Leaves the character with nothing researched (Ctrl+Z brings it back)
