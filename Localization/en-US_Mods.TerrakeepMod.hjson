Panel: {
	Titulo: Terrakeep
	Cerrar: Close ({0})
	Atajo: Shortcut: {0}

	// TM3 (visual redesign catalogue): header chips, visible from any tab. ObjetivoCorto is the
	// FIXED chip text (never changes length, never truncates); the real objective/tramo name,
	// which CAN be long (real measured example: "The first steps of Hardmode", 28 chars), goes
	// in the tooltip via AyudaObjetivo - same pattern the panel's own tabs already use (short
	// fixed label always visible + Ayuda with the full detail).
	Cabecera: {
		ObjetivoCorto: Objective
		Objetivo: Objective: {0}
		GuiaCompleta: Guide complete
		SinPartida: No character loaded
		AyudaHora: Current in-world time.
		AyudaObjetivo:
			'''
			{0}
			Click to open the Guide.
			'''
		// Functions catalogue idea 2 ("DPS meter").
		Dps: "{0} DPS"
		DpsSinDatos: No recent hits
		AyudaDps: Damage per second you've dealt in the last 10 real seconds.
	}

	Area: {
		Personaje: Character
		Libreria: Library
		Builds: Builds
		Investigacion: Research
		Exploracion: Exploration
		Ajustes: Settings
		Guia: Guide
		Album: Album
	}

	Ayuda: {
		Personaje: Everything you touch here is written straight to the loaded character.
		Libreria: Grab items from the catalogue with the mouse and drop them into any real container.
		Builds: Moves what you own; pulls the rest from the catalogue and places it too.
		Investigacion: It writes through Journey Mode's official API, so the game's own menu shows the same.
		Exploracion: Drag the mini-map to pan and use the wheel to zoom.
		Ajustes: The language changes live. Ctrl+Z undoes any Terrakeep action.
		Guia: Tells you what to do now and why, reading your real character. Direction, never coordinates.
		Album: Snaps a screenshot on its own every time you close a Guide milestone. Nothing to remember to press.
	}
}

Personaje: {
	Pestana: {
		Inventario: Inventory
		Almacenes: Storage
		Equipo: Equipment
		Buffs: Buffs
		Apariencia: Appearance
		Desbloqueos: Unlocks
		Conjuntos: Loadouts
		Completitud: Completion
	}

	Nombre: Name
	SinNombre: (no name)
	VidaMaxima: Max health
	ManaMaximo: Max mana
	VidaEfectiva: "{0} (effective {1})"
	ManaEfectivo: "{0} (effective {1})"
	Ahora: Now: {0}/{1} health, {2}/{3} mana
	Llenar: Refill health and mana
	Dinero: Money: {0}  (inventory {1} | storage {2})

	Moneda: {
