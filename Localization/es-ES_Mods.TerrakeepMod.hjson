Panel: {
	Titulo: Terrakeep
	Cerrar: Cerrar ({0})
	Atajo: Atajo: {0}

	// TM3 (visual redesign catalogue): header chips, visible from any tab. ObjetivoCorto is the
	// FIXED chip text (never changes length, never truncates); the real objective/tramo name,
	// which CAN be long (real measured example: "The first steps of Hardmode", 28 chars), goes
	// in the tooltip via AyudaObjetivo - same pattern the panel's own tabs already use (short
	// fixed label always visible + Ayuda with the full detail).
	Cabecera: {
		ObjetivoCorto: Objetivo
		Objetivo: Objetivo: {0}
		GuiaCompleta: Guía completa
		SinPartida: Sin partida
		AyudaHora: Hora del mundo ahora mismo.
		AyudaObjetivo:
			'''
			{0}
			Pulsa para abrir la Guía.
			'''
		// Functions catalogue idea 2 ("DPS meter").
		Dps: "{0} DPS"
		DpsSinDatos: Sin golpes recientes
		AyudaDps: Daño por segundo que has hecho en los últimos 10 segundos reales.
	}

	Area: {
		Personaje: Personaje
		Libreria: Librería
		Builds: Builds
		Investigacion: Investigación
		Exploracion: Exploración
		Ajustes: Ajustes
		Guia: Guía
		Album: Álbum
	}

	Ayuda: {
		Personaje: Todo lo que toques aquí se escribe al instante sobre el personaje cargado.
		Libreria: Coge objetos del catálogo con el ratón y suéltalos en cualquier contenedor real.
		Builds: Lo que tengas se mueve; lo que no tengas se trae del catálogo y se coloca igual.
		Investigacion: Se escribe por la vía oficial del Modo Viaje, así que el menú del juego refleja lo mismo.
		Exploracion: Arrastra el mini-mapa para moverte y usa la rueda para acercar.
		Ajustes: El idioma cambia en vivo. Ctrl+Z deshace cualquier acción de Terrakeep.
		Guia: Te dice qué hacer ahora y por qué, leyendo tu personaje real. Dirección, nunca coordenadas.
		Album: Captura sola cada vez que cierras un tramo de la Guía. No hace falta acordarse de pulsar nada.
	}
}

