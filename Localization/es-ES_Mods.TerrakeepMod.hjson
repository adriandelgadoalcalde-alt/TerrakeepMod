Keybinds: {
	AbrirPanel.DisplayName: Abrir Terrakeep
	# WS4 - builds and auto-equip.
	AbrirBuilds.DisplayName: Abrir las Builds de Terrakeep
	# WS3 - item library.
	AbrirLibreria.DisplayName: Abrir la Librería de Terrakeep
	# WS7 - settings and undo/redo history.
	AbrirAjustes.DisplayName: Abrir los Ajustes de Terrakeep
	Deshacer.DisplayName: Deshacer (con Ctrl)
	Rehacer.DisplayName: Rehacer (con Ctrl)
	# WS6 - world exploration and map.
	AbrirExploracion.DisplayName: Abrir la Exploración de Terrakeep
	# WS5 - research (Journey Mode).
	AbrirInvestigacion.DisplayName: Abrir la Investigación de Terrakeep
}

Configs: {
	AjustesConfig: {
		DisplayName: Ajustes de Terrakeep

		Idioma: {
			Label: Idioma de la interfaz
			Tooltip: En qué idioma muestra Terrakeep sus paneles. Elegir Español o English cambia el idioma del juego entero en el acto, porque tModLoader tiene un único idioma activo para todo.
		}

		AtajosYaSembrados: {
			// Label: Atajos Ya Sembrados
			// Tooltip: ""
		}
	}

	IdiomaDeTerrakeep: {
		SeguirElJuego: {
			Label: El del juego
			// Tooltip: ""
		}

		Espanol: {
			Label: Español
			// Tooltip: ""
		}

		English: {
			Label: English
			// Tooltip: ""
		}

		// Tooltip: ""
	}
}

Ajustes: {
	Titulo: Terrakeep - Ajustes
	Idioma: Idioma de la interfaz
	IdiomaSeguirElJuego: El del juego
	IdiomaEspanol: Español
	IdiomaIngles: English
	CulturaActiva: Idioma activo del juego ahora mismo: {0}
	Cerrar: Cerrar
	Historial: Deshacer y rehacer
	HistorialVacio: No hay nada en el historial de esta sesión.
	HistorialEntradas: Acciones guardadas en el historial: {0}
	Deshacer: Deshacer (Ctrl+Z)
	Rehacer: Rehacer (Ctrl+Y)
	DeshacerAlgo: Deshacer: {0}
	RehacerAlgo: Rehacer: {0}
	Atajos: Atajos de teclado
	AtajosNota: Cada tecla abre Terrakeep directamente en su pestaña. Reasignables en Ajustes > Controles del juego.
	AtajosHistorial: Deshacer y rehacer: {0} y {1} (con Ctrl pulsado).
	AtajosIcono: También se abre con el icono de Terrakeep, junto al bestiario y los emotes, cuando tienes el inventario abierto.
}

Historial: {
	Deshecho: Terrakeep ha deshecho: {0}
	Rehecho: Terrakeep ha rehecho: {0}
	NadaQueDeshacer: Terrakeep no tiene nada que deshacer.
	NadaQueRehacer: Terrakeep no tiene nada que rehacer.
}
