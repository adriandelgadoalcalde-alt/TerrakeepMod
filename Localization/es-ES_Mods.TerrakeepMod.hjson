	Tramo: {
		ReySlime: {
			Nombre: El Rey Slime (opcional)
			Resumen: 2000 de vida, en la superficie. El opcional más flojo de todo el árbol: se puede derrotar incluso antes del Ojo de Cthulhu.
		}

		PreOjo: {
			Nombre: Antes del primer jefe
			Resumen: Casa, mineral, cristales de vida y cuatro vecinos, hasta el Ojo de Cthulhu.
		}

		EjercitoGoblin: {
			Nombre: El Ejército Goblin (opcional)
			Resumen: Una invasión por oleadas, no un jefe único. Se puede invocar en cuanto uses 5 cristales de vida, incluso antes del Ojo de Cthulhu.
		}

		LegionDeEscarcha: {
			Nombre: La Legión de Escarcha (opcional)
			Resumen: Otra invasión por oleadas, pero de Modo Difícil y de Navidad: solo la invoca el Globo de nieve, que únicamente sale de los Regalos abiertos después del Muro de Carne. Sus tres tipos de enemigo aplican frío además del golpe.
		}

		Piratas: {
			Nombre: Los Piratas (opcional)
			Resumen: Otra invasión por oleadas, ya en Modo Difícil: el Mapa pirata solo lo sueltan los enemigos del océano después del Muro de Carne. Su enemigo más duro, el Capitán pirata, tiene mucha más defensa que los de las otras dos invasiones.
		}

		Deerclops: {
			Nombre: Deerclops (opcional)
			Resumen: 7000 de vida, en el bioma de nieve. Solo aparece de noche, durante una tormenta, y sin ningún otro peligro activo cerca.
		}

		MaldadDelMundo: {
			Nombre: La maldad de tu mundo
			Resumen: Devorador de Mundos o Cerebro de Cthulhu, según cómo se generó tu mundo. La primera vez que muere cae un meteorito seguro; después, una de cada dos.
		}

		ReinaAbeja: {
			Nombre: La Reina Abeja (opcional)
			Resumen: 3400 de vida, en la colmena de la jungla. No bloquea nada, pero lo que suelta adelanta todo el resto del prehardmode.
		}

		Esqueletron: {
			Nombre: Esqueletron y la Mazmorra
			Resumen: 4400 de vida. Al morir se abre la Mazmorra entera y llega el Sastre a vivir contigo.
		}

		MuroDeCarne: {
			Nombre: El Muro de Carne
			Resumen: 8000 de vida, en el Infierno. Al morir el mundo entra en Modo Difícil, y eso no tiene marcha atrás.
		}

		InicioModoDificil: {
			Nombre: Los primeros pasos del Modo Difícil
			Resumen: Minerales nuevos rompiendo Altares con el Gran martillo que suelta el Muro, y la Reina Slime (18000 de vida) como opcional.
		}

		Mecanicos: {
			Nombre: Los tres mecánicos
			Resumen: Destructor 80000, Gemelos 20000 y 23000, Esqueletron Prime 28000 de vida. Hacen falta los tres para que broten los bulbos de Plantera.
		}

		Plantera: {
			Nombre: Plantera
			Resumen: 30000 de vida, en un bulbo de la jungla subterránea. Al morir llega el Ciborg.
		}

		TemploYGolem: {
			Nombre: El Templo y el Golem
			Resumen: Golem, 15000 de vida y 26 de defensa, dentro del Templo de la Selva.
		}

		LocuraMarciana: {
			Nombre: La Locura Marciana (opcional)
			Resumen: Otra invasión por oleadas, sin objeto de invocación: la dispara sola una Sonda Marciana al detectarte, ya en Modo Difícil y con el Golem derrotado.
		}

		LunaDeCalabazas: {
			Nombre: La Luna de Calabazas (opcional)
			Resumen: Un evento por oleadas con dos jefes propios: Mourning Wood (14000 de vida) y Pumpking (26000 de vida), el que cierra el evento.
		}

		LunaHelada: {
			Nombre: La Luna Helada (opcional)
			Resumen: El evento por oleadas más largo de los dos: tres jefes propios, Everscream, Santa-NK1 y la Reina de Hielo (34000 de vida, la más alta de los tres).
		}

		EjercitoD2: {
			Nombre: El Antiguo Ejército D2 (opcional)
			Resumen: Defiende el Cristal eternia en tres dificultades: la 1 se abre con el Tabernero (tras la maldad de tu mundo), la 2 con un mecánico y la 3 con el Golem. Betsy (50000 de vida) solo aparece al final de la dificultad 3.
		}

		JefesOpcionalesTardios: {
			Nombre: Los opcionales de después
			Resumen: Duque Pezhongo (60000 de vida, 50 de defensa) y la Emperatriz de la Luz (70000). Opcionales, pero su equipo es lo mejor que hay antes de la luna.
		}

		EventosLunares: {
			Nombre: El Cultista y los Pilares
			Resumen: Cultista Lunático, 32000 de vida y 42 de defensa. Al morir empiezan los cuatro Pilares.
		}

		MoonLord: {
			Nombre: El Señor de la Luna
			Resumen: El final: 50000 de vida solo el núcleo, y 70 de defensa.
		}

		DesertScourge: {
			Nombre: El Desert Scourge (opcional, Calamity)
			Resumen: 4000-5000 de vida, en el Desierto. El primer jefe opcional de Calamity, pensado incluso antes del Ojo de Cthulhu.
		}

		GiantClam: {
			Nombre: El Giant Clam (opcional, Calamity)
			Resumen: 10 de defensa (35 en Modo Dificil), en el Sunken Sea. Solo aparece tras derrotar al Desert Scourge.
		}

		Crabulon: {
			Nombre: Crabulon (opcional, Calamity)
			Resumen: 3500-4400 de vida, en Hongos Luminosos. Pensado para justo despues del Ojo de Cthulhu.
		}

		HiveMindOPerforator: {
			Nombre: The Hive Mind / The Perforators (opcional, Calamity)
			Resumen: Segun tu mundo: Hive Mind (Corrupcion, 5000-7000 de vida) o Perforators (Carmesi, 4000-5750). Justo despues de la maldad de tu mundo.
		}

		SlimeGod: {
			Nombre: The Slime God (opcional, Calamity)
			Resumen: Dos Paladines que se fusionan en un nucleo final. El ultimo gran opcional de prehardmode, justo despues de Esqueletron.
		}

		DreadnautilusYHorribleHog: {
			Nombre: Dreadnautilus y Horrible Hog (opcional, Calamity)
			Resumen: Dos rarezas exclusivas de la Luna de Sangre: un BloodNautilus reescrito por Calamity y un cerdo salvaje mucho más duro de lo normal.
		}

		Cryogen: {
			Nombre: Cryogen (opcional, Calamity)
			Resumen: 25000-48000 de vida, en el bioma de Nieve. El primer jefe de Modo Dificil propio de Calamity.
		}

		AquaticScourge: {
			Nombre: Aquatic Scourge (opcional, Calamity)
			Resumen: 80000-96000 de vida, en el Sulphurous Sea. Su derrota desbloquea la fase 2 de la Lluvia Acida.
		}

		BrimstoneElemental: {
			Nombre: Brimstone Elemental (opcional, Calamity)
			Resumen: 30000-49200 de vida, en el Infierno. Uno de los tres opcionales de early hardmode de Calamity.
		}

		LluviaAcidaCragmawMire: {
			Nombre: Lluvia Acida: Cragmaw Mire (opcional, Calamity)
			Resumen: Miniboss del evento Lluvia Acida, fase 2. Solo aparece tras derrotar al Aquatic Scourge.
		}

		AstrumAureus: {
			Nombre: Astrum Aureus (opcional, Calamity)
			Resumen: 75000-120000 de vida y 40 de defensa, en la Infeccion Astral. No confundir con Astrum Deus, mas adelante.
		}

		CalamitasClone: {
			Nombre: Calamitas Clone (opcional, Calamity)
			Resumen: 30000-46875 de vida, en cualquier sitio. Del nivel de Plantera; no confundir con Supreme Calamitas, mucho más adelante.
		}

		GreatSandShark: {
			Nombre: Great Sand Shark (opcional, Calamity)
			Resumen: 9200-11000 de vida, en el Desierto. Miniboss opcional para despues de Plantera.
		}

		Ravager: {
			Nombre: Ravager (opcional, Calamity)
			Resumen: 30000-54000 de vida, cerca del Templo de la Selva. Pensado en dificultad para el nivel del Golem.
		}

		Plaguebringer: {
			Nombre: The Plaguebringer Goliath (opcional, Calamity)
			Resumen: 70000-105000 de vida, en la Jungla. La fuerza de la Plaga que se instala tras el Golem.
		}

		Dragonfolly: {
			Nombre: Dragonfolly (opcional, Calamity)
			Resumen: 150000-225000 de vida, en la Jungla. Pensado para poco despues del Señor de la Luna.
		}

		PrimordialWyrm: {
			Nombre: Primordial Wyrm (opcional y secreto, Calamity)
			Resumen: 2500000-3000000 de vida. Jefe oculto de postgame muy avanzado: vive en el Abismo y aparece al llevar allí el Estado caótico (Vara de la discordia).
		}

		LluviaAcidaTier3: {
			Nombre: Lluvia Acida: Mauler y Nuclear Terror (opcional, Calamity)
			Resumen: Minibosses del evento Lluvia Acida, fase 3. Solo aparecen tras derrotar a Polterghast.
		}

		AstrumDeus: {
			Nombre: Astrum Deus
			Resumen: 150000-240000 de vida. Desbloquea el Mineral Astral. Pensado para justo despues del Cultista, antes del Señor de la Luna.
		}

		ProfanedGuardiansYProvidence: {
			Nombre: Los Guardianes Profanos y Providence
			Resumen: Los Guardianes (80000-120000 de vida) dan el Nucleo Profano; Providence (250000-375000) es el arranque real del postgame de Calamity.
		}

		TrioPostProvidence: {
			Nombre: El trio de Providence: Ceaseless Void, Storm Weaver y Signus
			Resumen: Tres jefes (50000-380000 de vida cada uno) que Providence desbloquea. Muy recomendados antes de Polterghast.
		}

		Polterghast: {
			Nombre: Polterghast
			Resumen: 280000-420000 de vida, en la Mazmorra (postgame). Muy recomendado tras el trio de Providence.
		}

		OldDukeYDoG: {
			Nombre: The Old Duke y The Devourer of Gods
			Resumen: Old Duke (400000-600000 de vida) entre Polterghast y DoG; The Devourer of Gods (750000-900000) tras el trio de Providence y Polterghast.
		}

		Yharon: {
			Nombre: Yharon, Dragon of Rebirth
			Resumen: 1000000-1560000 de vida, en la Jungla (se enfurece si sales de ella). Tras el Devourer of Gods, antes del ultimo tramo.
		}

		ExoMechsYSupremeCalamitas: {
			Nombre: Exo Mechs y Supreme Witch, Calamitas: el final
			Resumen: Ares, Thanatos y Artemis&Apollo (1000000-1495000 cada uno) y Supreme Calamitas (750000-1150000). El final actual de Calamity.
		}
	}

	Paso: {
		Refugio: {
			Titulo: Una casa y un vecino
			Porque: Los vecinos no son decoración: la mitad de la progresión temprana pasa por ellos, y el propio juego cuenta cuántos tienes para decidir si el Ojo de Cthulhu aparece de noche. Además, de noche la superficie se llena de enemigos y una casa cerrada es la diferencia entre seguir jugando y volver a empezar el día.
			Como: Una habitación con paredes puestas, una puerta, una mesa, una silla y una fuente de luz ya cuenta como vivienda. El Guía se muda solo en cuanto haya una libre.
		}

		Defensa: {
			Titulo: Armadura: más de 10 de defensa
			Porque: La defensa te quita daño fijo de cada golpe que recibes: la mitad de tu defensa en modo normal, tres cuartos en experto y la defensa entera en maestro. No es un número de adorno, y además es una de las dos condiciones que el juego comprueba de verdad para dejar aparecer al Ojo de Cthulhu por la noche.
			Como: Un juego completo de cualquiera de los minerales de la primera capa ya pasa de 10. Si te falta poco, un accesorio o un buff de defensa lo cubre.
		}

		CristalesDeVida: {
			Titulo: Cinco cristales de vida (200 de vida)
			Porque: Los cristales son la única forma de subir la vida en esta parte del juego. Y ojo con un detalle que no se ve por ningún lado: el juego lleva un contador aparte de cuántos has USADO, y es ese contador el que mira para dejar aparecer al Ojo de Cthulhu, no tu vida máxima. Subir la vida a mano desde el editor de Terrakeep te deja con 200 de vida y el contador a cero, así que el Ojo no vendría nunca: hay que usarlos de verdad.
			Como: Brillan en las paredes de las cuevas, bastante por debajo de la superficie. Una antorcha y bajar en horizontal cubriendo terreno es más rápido que cavar en vertical.
		}

		PuebloDeCuatro: {
			Titulo: Cuatro vecinos
			Porque: Cuatro es el número exacto que el juego exige para que el Ojo de Cthulhu pueda aparecer solo al caer la noche. Cada vecino además se muda por un motivo concreto: el Mercader cuando entre todos los jugadores hay 50 de plata, la Enfermera en cuanto alguien haya usado un cristal de vida, y el Demoledor con un explosivo cualquiera en la mochila - ninguno de los dos últimos necesita que el Mercader viva ya contigo.
			Como: Construye las viviendas primero: un vecino no se muda si no hay una libre y válida, aunque cumplas su condición.
		}

		ArmaYArena: {
			Titulo: Un arma que le haga daño de verdad
			Porque: Aquí está la respuesta a por qué una espada de madera ya no vale, y no es una opinión: cada golpe que recibe un enemigo pierde la mitad de la defensa de ese enemigo, con un mínimo de 1. El Ojo de Cthulhu tiene 12 de defensa, así que resta 6 a cada golpe. Con un arma de 7 de daño le estás quitando 1 por golpe y tienes 2800 de vida por delante: no es que juegues mal, es que esa espada no puede.
			Como: Cualquier arma de mineral de la primera capa ya pasa de sobra. Unas plataformas largas para moverte en horizontal y unas pociones de curación cambian la pelea por completo, aunque el juego no te las pida.
		}

		InvocarElOjo: {
			Titulo: Llamarlo tú, en vez de esperarlo
			Porque: Cumpliendo todo lo anterior, el Ojo puede aparecer solo al caer la noche, pero solo una de cada tres noches: puedes pasarte varias noches preparado y sin que llegue. El Vidente Sospechoso lo llama cuando tú quieras, que es lo que te deja elegir el momento en vez de que te pille a medias.
			Como: Seis lentes en un Altar Demoniaco o Carmesí. Las lentes las sueltan los ojos que vuelan de noche por la superficie, así que salen solas mientras preparas el resto.
		}

		ArmaParaElReySlime: {
			Titulo: Cualquier arma, aunque sea de la primera capa
			Porque: El Rey Slime tiene 40 de daño, solo 10 de defensa y 2000 de vida - menos vida que el Ojo de Cthulhu, y se puede derrotar incluso ANTES que él. No bloquea nada del camino obligatorio, pero es el primer jefe de verdad con el que probarte, y suelta la Corona de Slime, que lo vuelve a invocar cuando quieras.
			Como: Aparece solo, muy de vez en cuando, con lluvia de slimes en la superficie. La Corona de Slime lo llama al instante si prefieres elegir tú el momento.
		}

		VencerAlReySlime: {
			Titulo: Derrotarlo (opcional)
			Porque: Nadie te obliga a plantarle cara: es el primer trofeo de verdad del juego, tan accesible que ni siquiera hace falta esperar al Ojo de Cthulhu. Lo que deja caer -la Corona, el Compañero Slime Real- es más un premio de coleccionista que una necesidad.
			Como: Salta hacia ti y suelta slimes más pequeños sin parar: una arena con plataformas para esquivar el salto vale más que espacio llano.
		}

		ArmaParaDeerclops: {
			Titulo: Un arma capaz de aguantar el frío
			Porque: Deerclops trae 20 de daño, 10 de defensa y 7000 de vida, pero el frío que deja tras cada golpe sigue mordiendo después de que te aparte: la pelea pesa más de lo que sugiere ese daño base. No bloquea nada del camino, pero es de los pocos jefes que puede plantarse en tu partida sin que tú decidas cuándo.
			Como: Solo sale a medianoche, en plena ventisca, dentro del bioma de nieve, sin vecinos ni otro peligro cerca y con 200 de vida o 9 de defensa - y si ya lo has derrotado, solo una de cada cuatro noches. El Trasto de ciervo lo llama al instante (también dentro de la nieve) si prefieres no quedarte esperando a que el tiempo se ponga de tu parte.
		}

		VencerADeerclops: {
			Titulo: Derrotarlo (opcional)
			Porque: No te abre ningún camino obligatorio: es un visitante de otro mundo, traído directamente de Don't Starve Together. Lo que deja atrás -el Hueso del ojo que invoca a Chester, el cofre viviente; la Ojombrilla; y una de sus cuatro armas, Lucy el Hacha entre ellas- es más recuerdo de trofeo que necesidad real.
			Como: Golpea el suelo y lanza pinchos de hielo en línea recta desde ambos lados: una arena elevada, lejos del suelo que pisa, evita la mayoría de sus ataques.
		}

		ArmaParaElEjercitoGoblin: {
			Titulo: Un arma que aguante una oleada entera
			Porque: No es un jefe único: son varias oleadas de goblins distintos (peones, ladrones, guerreros, hechiceros, arqueros) a la vez. El Guerrero Goblin es el más duro de los comunes, con 25 de daño y solo 8 de defensa - lo que de verdad pide este tramo es aguante frente a varios enemigos encima tuya a la vez, no perforar una defensa alta.
			Como: Necesitas haber usado ya 5 cristales de vida (200 de vida real) para poder invocarla tú mismo - es la misma condición que exige el propio juego, no un capricho de esta guía. Un arma de área o que atraviese varios enemigos rinde mejor que una que solo pega de uno en uno.
		}

		VencerAlEjercitoGoblin: {
			Titulo: Derrotarla (opcional)
			Porque: Rechazar la invasión no bloquea el camino obligatorio, pero es la única forma de que aparezca el Duende chapucero, atado en algún túnel bajo tus pies: libéralo y se muda contigo con su mostrador de reforja y su Taller, el accesorio que combina accesorios.
			Como: Pelea cerca de tu base, con pasillos estrechos y trampas: las oleadas vienen de los dos lados a la vez, y un cuello de botella vale más que espacio abierto.
		}

		ArmaParaLaLegionDeEscarcha: {
			Titulo: Un arma capaz de aguantar el frío de otra oleada
			Porque: Otra invasión por oleadas, con los mismos tres tipos de enemigo repitiéndose. Mister Estocada es el más duro, con 65 de daño y 26 de defensa, y los tres aplican frío además del golpe directo - el peligro real es que ese frío se acumula si no rompes el ritmo.
			Como: Nunca llega sola: hace falta un Globo de nieve, y ese solo sale (una de cada quince veces) de un Regalo abierto ya en Modo Difícil - y los Regalos los sueltan los enemigos solo en Navidad, del 15 al 31 de diciembre. Con el globo en la mano, la misma condición que el Ejército Goblin: 5 cristales de vida ya usados. Una fuente de calor o un buff contra el frío ayuda más aquí que en casi cualquier otro tramo.
		}

		VencerALaLegionDeEscarcha: {
			Titulo: Derrotarla (opcional)
			Porque: Rechazarla no te abre ningún camino obligatorio: es puramente un capricho navideño. Sus muñecos de nieve no sueltan más que Bloques de nieve; lo que de verdad cambia es que, con la Legión derrotada y todavía en Navidad, Papá Noel se muda a vivir contigo.
			Como: Igual que el Ejército Goblin: un cuello de botella cerca de tu base rinde mejor que pelear a campo abierto contra las dos direcciones a la vez.
		}

		ArmaParaLosPiratas: {
			Titulo: Un arma capaz de un enemigo mucho más blindado
			Porque: El Capitán Pirata es el enemigo común más duro de las tres invasiones por oleadas: 70 de daño y 30 de defensa, muy por encima de los 8 del Guerrero Goblin o los 26 de Mister Estocada. Cuidado con una idea equivocada muy extendida: el "Flying Dutchman" que se suele citar como el jefe del evento no es un enemigo real - es solo la nave, decorativa.
			Como: Es cosa del Modo Difícil: el Mapa pirata solo lo sueltan (una de cada cien veces) los enemigos del océano tras el Muro de Carne, y la invasión solo llega sola con el mundo ya en Modo Difícil y al menos un altar roto. Con el mapa, la misma condición que el Ejército Goblin: 5 cristales de vida ya usados.
		}

		VencerALosPiratas: {
			Titulo: Derrotarlos (opcional)
			Porque: Rechazarlos no te abre ningún camino obligatorio: otro extra, igual que el Ejército Goblin y la Legión de Escarcha. Lo que de verdad importa es el saqueo mientras dura el abordaje: el Capitán Pirata puede soltar el Cañón de Monedas o su propio báculo de invocación.
			Como: Igual que el Ejército Goblin: un cuello de botella cerca de tu base rinde mejor que pelear a campo abierto contra las dos direcciones a la vez.
		}

		ArmaContraLaMaldad: {
			Titulo: Un arma que aguante muchos golpes seguidos
			Porque: La misma fórmula de siempre (le quitas daño menos la mitad de su defensa, mínimo 1) aquí pesa menos que con el Ojo: los segmentos del Devorador de Mundos tienen entre 2 (cabeza) y 8 (cola) de defensa, y el propio Cerebro de Cthulhu 14, aunque no puedes tocarlo hasta que mueran los Reptadores que lo rodean. Lo que sí hace falta es aguante: el Devorador son decenas de segmentos de 150 de vida, con 22 de daño en la cabeza, y el Cerebro golpea 30 en contacto directo. Un arma corta y sin alcance te deja parado entre golpes; una que llegue lejos o dispare deja pegar y retroceder.
			Como: Cualquier arma con alcance o a distancia de la primera capa de mineral sirve de sobra. Un Corazón Carmesí o una Esfera Oscura rotos por accidente ya empiezan a acercar al jefe; si prefieres elegir el momento, la Comida de Gusano o la Espina Sangrienta lo invocan directamente.
		}

		VencerLaMaldad: {
			Titulo: Derrotarlo
			Porque: En cuanto caiga el Devorador de Mundos o el Cerebro de Cthulhu, el cielo te avisa de la primera victoria con un meteorito que cae seguro, el Tabernero pasa a poder rescatarse en las cavernas, y con su Endemoniado/Carmesí y sus escamas o muestras de tejido sale el Pico de pesadilla o el Pico mortífero: los primeros que pican Piedra infernal, el camino real al Muro de Carne. Lo que NO abre, aunque se diga mucho: los Altares. Romperlos exige el Gran martillo (el Pwnhammer, que solo suelta el Muro de Carne) y que el mundo ya esté en Modo Difícil; antes de eso el altar no se rompe y te quita la mitad de la vida al golpearlo.
			Como: El Devorador se corta en trozos: cada segmento partido por la mitad se separa en dos gusanos más, así que un arma que atraviese en línea (o con mucho alcance) acaba antes que una que solo pega de uno en uno. El Cerebro se esconde detrás de sus Reptadores: mátalos todos y pasa a su segunda fase, ya vulnerable hasta el final pero teletransportándose sin parar a tu alrededor.
		}

		ArmaParaEsqueletron: {
			Titulo: Un arma capaz de aguantar sus manos
			Porque: Esqueletron tiene 32 de daño y 10 de defensa en la cabeza: con la fórmula de siempre, un arma de 20 de daño le quita 15 por golpe, y hacen falta bastantes contra sus 4400 de vida - eso es solo la cabeza. Cada mano tiene su propia vida aparte, 600, así que en total hay cerca de 5600 de vida repartidos entre las dos manos y la cabeza, no 4400. Sus manos giran y golpean fuerte: sin alcance en tu arma, vas a recibir más de lo que das.
			Como: Cualquier arma de mineral de la segunda capa (o un arco con buenas flechas) ya cumple. El Anciano, siempre junto a la entrada de la Mazmorra, te reta a luchar contra él si le hablas de noche.
		}

		VencerAEsqueletron: {
			Titulo: Derrotarlo
			Porque: En cuanto cae, la Mazmorra baja la guardia: los Guardianes que la vigilaban para que nadie entrara antes de tiempo -con un daño pensado para hacerte retroceder- dejan de aparecer, y el Sastre hace las maletas para mudarse contigo.
			Como: Pelea cerca de la entrada de la Mazmorra, nunca dentro de ella: si amanece antes de matarlo, se cura de golpe entero y hay que empezar de cero.
		}

		ArmaParaElMuro: {
			Titulo: Un arma para un jefe con muchísima más vida
			Porque: El Muro de Carne tiene 8000 de vida, con 50 de daño y 12 de defensa en el cuerpo; su ojo pega igual de fuerte pero sin nada de defensa. Con la fórmula de siempre, un arma de 25 de daño le quita bastante más de la mitad a cada golpe, y hace falta ese salto: no es solo más vida que Esqueletron, es una pelea CRONOMETRADA que avanza sola hacia ti por un pasillo del Infierno, así que alargarla de más no es una opción.
			Como: Cualquier arma fundida con Piedra Infernal ya cumple de sobra. Una Poción de Piel de Obsidiana te libra del fuego de la lava mientras dura, y el Muñeco Vudú del Guía, lanzado a la lava, es la forma práctica de invocarlo sin tener que empujarlo tú mismo.
		}

		VencerAlMuro: {
			Titulo: Derrotarlo: el mundo cambia para siempre
			Porque: Aquí no hay medias tintas: en cuanto muere, tu mundo entero cruza al Modo Difícil, y no hay vuelta atrás en esta partida. A partir de ahí todo sube de golpe -enemigos nuevos y más duros hasta en zonas que ya dabas por seguras- pero también se abre lo que necesitas para seguir: suelta siempre el Gran martillo (Pwnhammer), el único martillo capaz de romper los Altares Demoniacos o Carmesíes, y cada altar roto reparte mineral nuevo por el mundo (Cobalto o Paladio con el primero, Mithril u Oricalco con el segundo, Adamantita o Titanio con el tercero). Con Calamity y su opción "Early Hardmode Progression Rework" (activada por defecto) el reparto cambia: los altares sueltan Almas de la noche, el Cobalto/Paladio brota solo al morir el Muro, y el resto lo sueltan los jefes mecánicos.
			Como: Construye un puente largo y llano sobre la lava antes de invocarlo: el Muro avanza solo hacia ti, así que necesitas sitio para retroceder disparando en vez de terreno irregular que te frene. Los ojos son su parte sin defensa; la boca, la más blindada.
		}

		ArmaParaLosMecanicos: {
			Titulo: Un arma capaz de un jefe de Hardmode de verdad
			Porque: Los tres suben el listón de golpe: los Gemelos tienen 10 de defensa con 20000 y 23000 de vida, Esqueletron Prime 24 de defensa con 28000, y el Destructor su cabeza sin defensa pero el cuerpo y la cola a 30 y 35, con 80000 de vida repartidos en decenas de segmentos. Con la fórmula de siempre, un arma de 40 de daño deja golpes útiles contra los tres sin que la pelea se eternice, y esa vida tan alta es la razón: un arma floja aquí no pierde la pelea de golpe, la alarga hasta que un error la pierde por ti.
			Como: Cualquier arma de mineral de Hardmode temprano (Cobalto/Paladio o superior) ya cumple. Se invocan de noche con un objeto concreto cada uno: Ojo Mecánico para los Gemelos, Gusano Mecánico para el Destructor, Cráneo Mecánico para Esqueletron Prime. No hace falta pelear a los tres a la vez ni en un orden fijo.
		}

		VencerAUnMecanico: {
			Titulo: Derrotar a los tres
			Porque: Con el primero que cae ya empiezan a brotar las Frutas de la vida en la jungla, puede llegar el Eclipse Solar y se abre la dificultad 2 del Antiguo Ejército. Pero los bulbos de Plantera solo crecen con los TRES mecánicos derrotados: hasta que no caigan el Destructor, los Gemelos y Esqueletron Prime, no hay forma de invocarla. Sus Lingotes sagrados y sus almas dan el mejor equipo que vas a tener antes de ella.
			Como: Los Gemelos y Esqueletron Prime vuelan y persiguen: un arena elevada con plataformas ayuda más que el suelo. El Destructor es un gusano larguísimo: un arma que atraviese en línea recta acaba con más de un segmento por disparo.
		}

		ArmaParaPlantera: {
			Titulo: Un arma que aguante DOS peleas seguidas
			Porque: Plantera tiene 50 de daño, 14 de defensa y 30000 de vida, pero el número que de verdad importa aquí no es la defensa: en cuanto baja de la mitad de su vida se enrabia, acelera y persigue mucho más deprisa por toda la jungla. No es un jefe más duro de atravesar, es DOS peleas distintas seguidas, y la segunda te puede acorralar si no tienes con qué mantener el ritmo. 45 de daño ya se nota, pero aquí compensa más una buena movilidad que un número mayor.
			Como: Rompe un bulbo de Plantera en la jungla subterránea para invocarla; solo brotan con los tres mecánicos derrotados. Despeja un pasillo largo antes de romperlo: la segunda fase persigue en línea recta y la jungla natural está demasiado cerrada para esquivar.
		}

		VencerAPlantera: {
			Titulo: Derrotarla
			Porque: Al caer suelta siempre la Llave del templo, la única que abre la puerta de piedra del Templo de la Selva, y el Ciborg se muda a vivir contigo. Además la Mazmorra se llena de enemigos nuevos (con su Ectoplasma, la base de los eventos lunares de después) y por fin se pueden abrir los cofres de bioma con sus llaves.
			Como: Pelea en el pasillo que despejaste, nunca en la jungla cerrada: sus tentáculos y semillas persiguen mejor entre árboles apretados que en un corredor limpio.
		}

		ArmaParaElTemplo: {
			Titulo: Un arma para las tres fases del Golem
			Porque: El Golem pelea en tres piezas con números distintos: la cabeza montada tiene 64 de daño, 20 de defensa y 25000 de vida; el cuerpo 72 de daño, 26 de defensa y 15000; y cuando la cabeza cae se suelta y vuela por su cuenta con 32 de defensa, 80 de daño y 16000 más. El detalle que decide la pelea: el CUERPO no recibe daño mientras la cabeza siga montada, así que empieza por ella. Con la fórmula de siempre, 55 de daño deja golpes útiles en las tres piezas sin que la última, la más dura, se haga eterna.
			Como: La puerta de piedra del Templo se abre con la Llave del templo que suelta Plantera. Dentro, los cofres del Templo y sus Lihzahrd y Serpientes voladoras sueltan Células de poder de lihzahrd: úsalas en el Altar de lihzahrd para invocarlo. Destruye primero la cabeza; hasta entonces el cuerpo no se puede dañar, y los puños se pueden ignorar o romper aparte.
		}

		VencerAlGolem: {
			Titulo: Derrotarlo
			Porque: Con él en el suelo se abre lo que viene después: los Cultistas aparecen por fin junto a la entrada de la Mazmorra (y con ellos el Cultista Lunático), la Sonda Marciana puede empezar a rondar, y se desbloquea la dificultad 3 del Antiguo Ejército, la única con Betsy. Suelta además el Picoserrucho y Caparazones de escarabajo, la base de la armadura de escarabajo.
			Como: Pelea dentro de la sala del Templo, con espacio para rodear los pilares de piedra: te protegen de sus golpes de área mientras esperas la abertura.
		}

		PrepararLocuraMarciana: {
			Titulo: Un arma capaz del enemigo mejor blindado
			Porque: El Oficial Marciano es el enemigo común más blindado de las cuatro invasiones del árbol: 50 de defensa, 75 de daño y 300 de vida - por delante de los 30 del Capitán Pirata, los 26 de Mister Estocada y los 8 del Guerrero Goblin. Con la fórmula de siempre, 60 de daño deja golpes útiles.
			Como: A diferencia del Ejército Goblin, la Legión de Escarcha o los Piratas, esta invasión no tiene objeto de invocación: una Sonda Marciana aparece sola, por probabilidad, en Modo Difícil y con el Golem ya derrotado, lejos del punto de aparición del mundo. En cuanto te detecta y logra huir sin que la mates, arranca la invasión ella sola - matarla antes de que escape no la dispara.
		}

		VencerALaLocuraMarciana: {
			Titulo: Derrotarla (opcional)
			Porque: Rechazar la invasión no abre ningún camino obligatorio: un extra más, igual que el Ejército Goblin, la Legión de Escarcha y los Piratas. Se da por superada cuando barres la oleada entera, no al derribar un único objetivo: el propio platillo (Núcleo, Torreta y Cañón) es la pieza más dura, pero esto es una guerra contra un ejército, no un duelo contra uno solo.
			Como: Igual que las otras tres invasiones: un cuello de botella cerca de tu base rinde mejor que pelear a campo abierto. El platillo no es un solo enemigo: son seis NPC luchando juntos, un Núcleo de 10000 de vida escoltado por dos Torretas de 5000 y dos Cañones de 3500 cada uno - repartir el daño entre ellos es más seguro que ignorarlos para ir directo al Núcleo.
		}

		ArmaParaMourningWood: {
			Titulo: Un arma para el primero de los dos jefes del evento
			Porque: Mourning Wood tiene 120 de daño, 34 de defensa y 14000 de vida y llega en la sexta oleada de la Luna de Calabazas, la primera de las dos que hay que superar.
			Como: Solo se puede invocar de noche y si no hay ya otro evento de oleadas en marcha. Un espacio cerrado con pasillos estrechos ayuda tanto contra él como contra el resto de la oleada.
		}

		VencerAMourningWood: {
			Titulo: Derrotarlo (opcional)
			Porque: Tumbarlo no cierra la noche entera: solo marca al primero de los dos jefes como caído. La Luna de Calabazas sigue hasta la décima oleada, cuando por fin llega Pumpking.
			Como: Lanza troncos en llamas a distancia: no te quedes quieto en su línea de tiro.
		}

		ArmaParaPumpking: {
			Titulo: Un arma para el jefe que cierra el evento
			Porque: Pumpking tiene 50 de daño, 40 de defensa y 26000 de vida - menos daño por golpe que Mourning Wood, pero casi el doble de vida y más defensa.
			Como: Llega en la décima oleada, ya con Mourning Wood superado: no hace falta volver a usar el Medallón, el evento sigue solo si aguantas hasta entonces.
		}

		VencerAPumpking: {
			Titulo: Derrotarlo: cierra el evento
			Porque: Con él caído, la Luna de Calabazas se cierra del todo. Deja su propio botín exclusivo, distinto del de Mourning Wood.
			Como: Vuela y dispara calabazas explosivas a distancia: el combate es casi todo aéreo, un gancho ayuda a seguirle el ritmo.
		}

		ArmaParaEverscream: {
			Titulo: Un arma para el primero de los tres jefes del evento
			Porque: Everscream tiene 110 de daño, 38 de defensa y 13000 de vida y llega en la cuarta oleada de la Luna Helada, la primera de las tres que hay que superar.
			Como: Solo se puede invocar de noche y si no hay ya otro evento de oleadas en marcha. Igual que con la Luna de Calabazas, un cuello de botella cerca de tu base ayuda contra toda la oleada.
		}

		VencerAEverscream: {
			Titulo: Derrotarlo (opcional)
			Porque: Tumbarlo solo marca al primero de los tres como caído: la Luna Helada sigue hasta la undécima oleada, cuando llega la Reina de Hielo, con Santa-NK1 esperando a mitad de camino.
			Como: Dispara ráfagas de proyectiles helados a distancia, parecido a Mourning Wood pero con más cadencia.
		}

		ArmaParaSantaNK1: {
			Titulo: Un arma para el segundo jefe: el más blindado de los tres
			Porque: Santa-NK1 tiene 120 de daño, 56 de defensa y 18000 de vida - la defensa más alta de los tres jefes del evento, muy por encima de los 38 de Everscream y la Reina de Hielo.
			Como: Llega en la séptima oleada. Dispara regalos explosivos y ráfagas de ametralladora en línea recta: moverte en diagonal esquiva más que retroceder en línea.
		}

		VencerASantaNK1: {
			Titulo: Derrotarlo (opcional)
			Porque: Con él caído, van dos de tres. Queda la Reina de Hielo, la última en llegar y la más resistente de todas.
			Como: Es un tanque casi estático: rinde mejor un arma con mucho alcance o que dispare que una cuerpo a cuerpo.
		}

		ArmaParaIceQueen: {
			Titulo: Un arma para el jefe que cierra el evento
			Porque: La Reina de Hielo tiene 120 de daño, 38 de defensa y 34000 de vida - la más alta de los tres jefes del evento - y coldDamage=true, aplica frío extra además del golpe directo.
			Como: Llega en la undécima oleada, con Everscream y Santa-NK1 ya superados: el evento sigue solo, sin volver a usar el Regalo asqueroso. Una fuente de calor o un buff contra el frío ayuda aquí más que en ningún otro tramo.
		}

		VencerAIceQueen: {
			Titulo: Derrotarla: cierra el evento
			Porque: Con ella en el suelo, la Luna Helada se cierra del todo: el más largo de los dos eventos por oleadas, once rondas hasta que aparece, frente a las diez de la Luna de Calabazas.
			Como: Dispara ráfagas de cristales de hielo en abanico: moverte en círculos amplios deja menos huecos que retroceder en línea recta.
		}

		ArmaParaElEjercitoD2: {
			Titulo: Un arma capaz de un asedio entero
			Porque: Betsy tiene 80 de daño, 38 de defensa y 50000 de vida, pero solo aparece en la última oleada de la dificultad 3, la que se abre con el Golem derrotado. Antes hay dos dificultades más: la 1, disponible en cuanto rescatas al Tabernero (tras la maldad de tu mundo), y la 2, que se abre con cualquier mecánico caído. Cada una son varias oleadas de enemigos propios del evento (goblins etéreos, wyverns, magos oscuros, ogros...).
			Como: El Cristal eternia y su Stand no se fabrican: los vende el Tabernero por Medallas del Defensor. Coloca el Stand, y con el Cristal en la mochila haz clic derecho sobre él: se consume y arranca el asedio, siempre que no haya ya otro en marcha ni sea Luna de Calabazas o Helada.
		}

		VencerAlEjercitoD2: {
			Titulo: Superar un asedio entero (opcional)
			Porque: Aguantar hasta la última oleada en CUALQUIERA de las tres dificultades ya cuenta como victoria - no hace falta la más dura, aunque el mejor botín (y Betsy) esperan en la dificultad 3.
			Como: Protege el Cristal de Eternia, no solo a ti mismo: si cae, el asedio termina en derrota aunque tú sigas vivo. Construir pasillos estrechos alrededor del cristal, con trampas, ayuda más que pelear a cuerpo descubierto.
		}

		ArmaParaElCultista: {
			Titulo: Un arma capaz del último guardián
			Porque: El Cultista Lunático tiene 50 de daño, 42 de defensa (la más alta de todo el prehardmode y el hardmode hasta ahora) y 32000 de vida. Con la fórmula de siempre, 65 de daño deja golpes útiles: por debajo de eso, gran parte de cada golpe se la come su defensa y apenas se nota.
			Como: Se le encuentra junto a la entrada de la Mazmorra, rodeado de cuatro seguidores que lo protegen. Mátalos a los cuatro primero: en cuanto caen, el propio Cultista aparece solo.
		}

		VencerAlCultista: {
			Titulo: Derrotarlo
			Porque: Aquí no hay término medio: en cuanto cae, el cielo se abre y las cuatro torres lunares llegan en el acto, sin previo aviso ni margen para prepararte después. Ve con todo listo, porque lo que sigue no espera.
			Como: Sus hechizos giran a tu alrededor y detonan: muévete en círculos amplios en vez de en línea recta para no quedarte encerrado dentro de uno.
		}

		PrepararLasTorres: {
			Titulo: Aguantar cuatro asedios seguidos
			Porque: Las cuatro torres (Solar, Vórtice, Nébula y Polvo Estelar) comparten 20 de defensa y 20000 de vida cada una y no atacan por sí mismas: el peligro real son las oleadas de enemigos de su color que invocan sin descanso mientras sigan en pie, algunos con hasta 100 de daño por golpe. No es un jefe, son cuatro asedios seguidos: 75 de daño ya deja golpes útiles contra la torre y contra lo que suelta.
			Como: El evento empieza solo al matar al Cultista: las cuatro torres aparecen a la vez, una por cada punto cardinal lejos de tu base. Puedes ir de una a otra en el orden que quieras y hasta dejarlo a medias; sus escudos se debilitan matando a los enemigos que invocan.
		}

		VencerALasTorres: {
			Titulo: Derrotar a las cuatro
			Porque: No basta con una: las cuatro tienen que caer para dar el asedio por superado. Cada una suelta fragmentos de su color, y esos fragmentos son el único material del que sale el Sello Celestial: sin las cuatro torres en el suelo, no hay forma de invocar al Señor de la Luna.
			Como: No hace falta derrotarlas en la misma sesión: el evento se puede retomar más tarde si toca retirarse. Guarda los fragmentos de cada una hasta tener los cuatro colores para el Sello Celestial.
		}

		ArmaParaMoonLord: {
			Titulo: El final: un arma para 145000 de vida repartida
			Porque: El Señor de la Luna se pelea en tres piezas con sus propios números: el núcleo tiene 70 de defensa y 50000 de vida PROPIA y no recibe ni un rasguño hasta que caen sus dos manos y la cabeza - más de 145000 de vida en total repartida entre las tres. Con la fórmula de siempre, 90 de daño deja golpes útiles en las tres, y la vida máxima cuenta tanto como el arma: sus rayos y las caídas de meteoro perdonan poco margen de error.
			Como: Fabrica el Sello celestial con 12 fragmentos de cada una de las cuatro torres en el Manipulador antiguo (el que suelta el Cultista) y úsalo para invocarlo. Construye antes una plataforma alta y despejada, lejos de bloques sólidos: sus manos y su cabeza descienden desde el cielo y necesitas sitio para esquivar en las cuatro direcciones.
		}

		VencerAMoonLord: {
			Titulo: Derrotarlo: el final de esta guía
			Porque: Con él caído, la historia principal llega a su final: no hay ningún otro jefe esperándote después. A partir de aquí el mundo sigue abierto -el Duque Pezhongo, la Emperatriz de la Luz, la pesca y lo que te haya quedado suelto- pero el camino que empezó la primera noche que viste al Ojo de Cthulhu termina exactamente aquí.
			Como: Golpea el núcleo mientras las manos y la cabeza siguen vivas y no le harás nada: destrúyelas primero, empezando por las manos, que son las que te agarran y te acercan a su boca.
		}

		ArmaParaLaReina: {
			Titulo: Un arma cualquiera de la primera capa
			Porque: La Reina Abeja tiene 30 de daño, 3400 de vida y solo 8 de defensa - menos incluso que el Ojo de Cthulhu. No bloquea nada del camino obligatorio, pero suelta equipo (el Aguijón Abeja, la armadura de Abeja) que adelanta el resto del prehardmode de verdad si la pillas pronto.
			Como: Vive en las Colmenas de la jungla (superficie o subterránea). Rompe una larva de abeja reina para invocarla, o usa una Abeemination si prefieres elegir el momento tú mismo.
		}

		VencerALaReina: {
			Titulo: Derrotarla (opcional)
			Porque: No te abre ningún camino obligatorio: es puro extra. Pero lo que deja caer -el Aguijón Abeja, Honeycomb, la armadura de Abeja- es de lo mejor que vas a encontrar tan pronto en la partida.
			Como: Vuela errática y dispara abejas y proyectiles punzantes en línea recta: un pasillo horizontal despejado dentro de la colmena es más seguro que perseguirla entre los túneles de cera.
		}

		ArmaParaLaReinaSlime: {
			Titulo: Un arma de mineral de Hardmode ya fundida
			Porque: La Reina Slime tiene 60 de daño, 26 de defensa y 18000 de vida - un primer filtro razonable nada más entrar en Hardmode. No bloquea nada, pero es la primera prueba real de que el mineral nuevo (Cobalto/Paladio) ya vale para algo.
			Como: Se invoca con el Cristal gelatinoso, que se encuentra en el Sagrado subterráneo, y solo dentro del bioma Sagrado - a cualquier hora, de día o de noche. Salta muy alto: una arena con varias plataformas ayuda más que el suelo llano.
		}

		VencerALaReinaSlime: {
			Titulo: Derrotarla (opcional)
			Porque: No bloquea el camino a los mecánicos ni a nada obligatorio. Deja caer el Sillín gelatinoso -una montura voladora, un vuelo que te adelanta años luz a lo que había antes-, el Gancho de Disonancia, el Báculo de cuchillas y piezas de la armadura de asesino de cristal.
			Como: Sus ataques son casi todos cuerpo a cuerpo y saltos: mantener las distancias con un arma a distancia o mágica es más seguro que pelear cuerpo a cuerpo contra sus caídas.
		}

		ArmaParaFishron: {
			Titulo: El arma más exigente antes de la luna
			Porque: El Duque Pezhongo tiene 100 de daño, 50 de defensa y 60000 de vida - el daño más alto de todo el árbol hasta el propio Moon Lord. Es opcional del todo, pero mucha gente lo considera más difícil que el Cultista o incluso que las torres: no hay atajo aquí, hace falta equipo de verdad.
			Como: Se invoca pescando con un Gusano Trufado en el océano (izquierda o derecha del mundo). Pelea sobre agua abierta y llana: sus fases finales llenan el aire y el agua de proyectiles y necesitas sitio en las tres dimensiones para esquivar.
		}

		VencerAFishron: {
			Titulo: Derrotarlo (opcional)
			Porque: No abre nada del camino obligatorio. Deja una de sus cinco armas (Flairón, Tsunami, Tifón de cuchillas, Pistola de burbujas o el Báculo de tempestad) y, una de cada quince veces, las Alas de Fishron: de lo mejor que hay disponible antes de la luna.
			Como: Cambia de patrón varias veces según baja de vida: lo que esquivas en la primera fase no sirve en la última. Mantén el movimiento constante en vez de plantarte en un sitio fijo.
		}

		ArmaParaLaEmperatriz: {
			Titulo: Un arma para la vida más alta de los opcionales
			Porque: La Emperatriz de la Luz tiene 80 de daño, 50 de defensa y 70000 de vida - la vida más alta de todos los jefes opcionales tardíos. Y tiene una regla propia: de DÍA está enfurecida y cada uno de sus golpes es letal; de NOCHE es la pelea normal. Matarla enfurecida es el reto que premia con la Terraprisma, pero no es la forma de conocerla.
			Como: Mata a la Crisopa prismática, una criatura inofensiva que solo aparece en la superficie del Sagrado de noche, antes de medianoche y con Plantera ya derrotada. Pelea DE NOCHE la primera vez: de día cada golpe suyo te mata de un toque.
		}

		VencerALaEmperatriz: {
			Titulo: Derrotarla (opcional)
			Porque: No bloquea nada obligatorio. Deja caer algunas de las mejores alas y accesorios de movilidad de toda la partida, útiles hasta en la pelea contra el propio Señor de la Luna.
			Como: Vuela en patrones circulares y deja rastros de proyectiles que se quedan flotando: aléjate en línea recta después de cada ráfaga en vez de intentar esquivar dentro de la nube que deja atrás.
		}

		ArmaParaDesertScourge: {
			Titulo: Cualquier arma con algo de alcance
			Porque: El Desert Scourge tiene 4 de defensa y entre 4000 y 5000 de vida segun el modo - menos vida que el Ojo de Cthulhu. Es intencionadamente el primer jefe opcional de Calamity, pensado para antes o justo despues del Rey Slime.
			Como: No aparece nunca solo: el Medallón del Desierto, usado dentro del Desierto, es la única forma de invocarlo.
		}

		VencerADesertScourge: {
			Titulo: Derrotarlo (opcional)
			Porque: No te abre ningún camino obligatorio: es el reto opcional más temprano de todo lo que trae Calamity. Deja materiales para la primera tanda de armas y armadura propias del mod.
			Como: Se mueve en linea recta hacia ti bajo la arena: mantente en el aire o sobre una plataforma alta para esquivar sus embestidas.
		}

		PrepararGiantClam: {
			Titulo: Cualquier arma, y haber derrotado ya al Desert Scourge
			Porque: El Giant Clam tiene 10 de defensa en prehardmode (35 en Modo Difícil, la misma criatura pero curtida) y solo se deja ver, RARA vez, nadando por el Sunken Sea - y solo después de que hayas dejado atrás al Desert Scourge, por eso este tramo llega justo detrás.
			Como: No tiene objeto de invocacion: nada mas que explorar el Sunken Sea (bajo el Oceano, mas alla de la Cripta Carmesi/Corrupta submarina) hasta que aparezca uno nadando.
		}

		VencerAGiantClam: {
			Titulo: Derrotarlo (opcional)
			Porque: Es puro extra: el primer miniboss de verdad que guarda el Sunken Sea. Hay una versión de Modo Difícil bastante más curtida (35 de defensa) que suelta mejor botín - la misma criatura, no un tramo aparte.
			Como: Ataca embistiendo en linea recta bajo el agua: un respirador o pocion de respiracion acuatica evita que el aire se convierta en el problema real de la pelea.
		}

		ArmaParaCrabulon: {
			Titulo: Un arma capaz de perforar su caparazon
			Porque: Crabulon tiene 8 de defensa y 3500-4400 de vida - un pelin mas duro que el Rey Slime, pensado para justo despues del Ojo de Cthulhu.
			Como: No brota solo: el Decapodita Sprout lo invoca, y solo se puede usar dentro de un bioma de Hongos Luminosos que esté bajo tierra, por debajo de la superficie.
		}

		VencerACrabulon: {
			Titulo: Derrotarlo (opcional)
			Porque: No bloquea nada del camino obligatorio. Deja caer la primera tanda de equipo propio de Calamity, útil para el resto del prehardmode.
			Como: Salta hacia ti y dispara esporas en arco: mantente en movimiento horizontal en vez de plantarte, sus esporas cubren una franja ancha si te quedas quieto.
		}

		ArmaParaHiveMindOPerforator: {
			Titulo: Un arma que aguante una pelea larga
			Porque: Igual que el Devorador de Mundos y el Cerebro de Cthulhu en vanilla, tu mundo decide cuál de los dos monstruos de Calamity te toca enfrentar: The Hive Mind en Corrupción (8 de defensa, 5000-7000 de vida) o The Perforators en Carmesí (4 de defensa, 4000-5750 de vida) - cualquiera de los dos vale para seguir adelante.
			Como: Rompe un Hive Tumor (Corrupcion) o un Perforator Cyst (Carmesi) para invocarlo la primera vez; despues, Teratoma o Cebo de Gusanos Sangriento lo repiten.
		}

		VencerAHiveMindOPerforator: {
			Titulo: Derrotarlo (opcional)
			Porque: No bloquea nada obligatorio en Calamity (a diferencia de vanilla, donde su equivalente SÍ hace falta antes del Muro de Carne). Aquí es un reto de verdad opcional, pensado para justo después de que te enfrentes a la maldad de tu mundo.
			Como: Las dos versiones lanzan enjambres de enemigos menores sin parar: prioriza despejar el espacio cercano antes que centrarte solo en el jefe.
		}

		ArmaParaSlimeGod: {
			Titulo: Un arma capaz de dos fases seguidas
			Porque: The Slime God empieza como dos Paladines (Crimulan y Ebonian) que se fusionan en el nucleo final. Pensado por la propia wiki para justo despues de Esqueletron, el ultimo tramo importante de prehardmode de Calamity.
			Como: El Overloaded Sludge lo invoca en cualquier sitio. Prepara curacion para dos fases distintas: los Paladines primero, el nucleo fusionado despues.
		}

		VencerASlimeGod: {
			Titulo: Derrotarlo (opcional)
			Porque: No bloquea nada obligatorio: es el último gran reto opcional antes del Muro de Carne. Deja el equipo tope de prehardmode de Calamity, lo mejor que vas a llevar puesto antes de cruzar al Modo Difícil.
			Como: Los dos Paladines se potencian entre si mientras vivan los dos: prioriza rematar a uno rapido en vez de repartir el daño por igual.
		}

		PrepararDreadnautilus: {
			Titulo: Estar listo para una Luna de Sangre
			Porque: El Nautilo terrible ya es en vanilla un miniboss que se pesca en Luna de Sangre (7000 de vida, 55 de daño, 24 de defensa); Calamity le reescribe la inteligencia entera y lo vuelve mucho más peligroso. El Horrible Hog es la otra sorpresa de la misma noche: un cerdo salvaje corriente que, por algún motivo, ha crecido mucho más de lo normal - solo sale en Luna de Sangre y con el Ojo de Cthulhu ya derrotado.
			Como: Ninguno de los dos tiene objeto de invocacion de verdad: solo aparecen durante una Luna de Sangre real. Un anillo/reloj de Luna de Sangre o esperar la aleatoria de cada noche es la unica via.
		}

		VencerADreadnautilusYHorribleHog: {
			Titulo: Derrotar a cualquiera de los dos (opcional)
			Porque: Ninguno de los dos bloquea nada obligatorio: son las dos curiosidades que la Luna de Sangre de Calamity guarda para quien se atreva a salir esa noche, pensadas para el mismo tramo que Esqueletron y el Slime God.
			Como: El Dreadnautilus nada en linea recta y muerde fuerte para prehardmode; el Horrible Hog embiste en tierra. Los dos se pueden esquivar con plataformas y distancia.
		}

		ArmaParaCryogen: {
			Titulo: Tu primer arma de Modo Dificil de Calamity
			Porque: Cryogen tiene 15 de defensa y 25000-48000 de vida - el primer jefe hardmode PROPIO de Calamity, pensado para el mismo momento que los mecanicos de vanilla.
			Como: La Llave Criogénica lo invoca dentro del bioma de Nieve. Se fabrica en un yunque con 50 bloques de hielo, 5 Almas de luz, 5 Almas de noche y 8 Esencias de Eleum (las sueltan los enemigos de la nieve en Modo Difícil): se puede intentar nada más cruzar al Modo Difícil. Su primera muerte hace brotar el Mineral Criónico en la nieve.
		}

		VencerACryogen: {
			Titulo: Derrotarlo (opcional)
			Porque: No bloquea nada del camino obligatorio de Calamity, pero te abre la primera tanda de verdad de equipo hardmode del mod - vale la pena antes de ir a por los mecánicos.
			Como: Alterna entre varias fases de proyectiles helados: los patrones son predecibles, pero se acumulan rapido si no mantienes distancia.
		}

		ArmaParaAquaticScourge: {
			Titulo: Un arma que aguante un gusano largo
			Porque: Aquatic Scourge tiene 10 de defensa y 80000-96000 de vida - mucha mas vida que Cryogen, pero menos defensa. Su derrota desbloquea la fase 2 del evento Lluvia Acida.
			Como: El Marisco (Seafood) lo invoca, pero solo dentro del Sulphurous Sea; también puede aparecer solo, rarísimamente, nadando en sus aguas.
		}

		VencerAAquaticScourge: {
			Titulo: Derrotarlo (opcional)
			Porque: No bloquea el camino obligatorio, pero SÍ hace que el cielo se ponga peor: desbloquea la segunda fase de la Lluvia Ácida de Calamity, y con ella la posibilidad de que aparezca el Cragmaw Mire.
			Como: Es un gusano segmentado largisimo: como el Devorador de Mundos de vanilla, cada segmento cuenta como un golpe, asi que un arma de area rinde mas que una de un solo objetivo.
		}

		ArmaParaBrimstoneElemental: {
			Titulo: Un arma capaz de un jefe defensivo
			Porque: Brimstone Elemental tiene 15 de defensa y 30000-49200 de vida, en la franja de early hardmode junto a Cryogen y Aquatic Scourge.
			Como: El Ídolo Chamuscado la invoca, pero solo dentro de los Riscos de Azufre (Brimstone Crag), su bioma en el Infierno. Alterna tres fases: deriva hacia ti teletransportándose, embiste disparando bolas de fuego, y se encierra en su capullo.
		}

		VencerABrimstoneElemental: {
			Titulo: Derrotarlo (opcional)
			Porque: No bloquea nada obligatorio: uno más del trío opcional de early hardmode que ofrece Calamity, junto a Cryogen y Aquatic Scourge - el orden entre los tres da igual, elige el tuyo.
			Como: En su fase de capullo cierra los pétalos, sube muchísimo la defensa y dispara anillos de dardos: no gastes tus mejores ataques ahí, guárdalos para cuando vuelve a abrirse y embiste.
		}

		PrepararLluviaAcida2: {
			Titulo: Estar listo para la Lluvia Acida (fase 2)
			Porque: Cragmaw Mire es un miniboss que solo entra en la lista de la Lluvia Ácida cuando el Aquatic Scourge ya ha caído: es la bandera de ese jefe, no un contador de puntos, la que cambia la fase del evento (y sube lo que hay que matar de 110 a 135 enemigos para un jugador).
			Como: La Lluvia Ácida empieza sola, por probabilidad, o al instante con una Lágrima Cáustica - pero solo con el Ojo de Cthulhu ya derrotado o el mundo en Modo Difícil. Se corta sola si pasan dos minutos y medio sin matar nada.
		}

		VencerACragmawMire: {
			Titulo: Derrotarlo (opcional)
			Porque: No bloquea nada obligatorio: un miniboss extra que la Lluvia Ácida trae consigo, pensado para la misma franja que Brimstone Elemental.
			Como: Se mueve rapido bajo el agua acida: cuidado con el propio ambiente, no solo con el enemigo, la lluvia acida daña por su cuenta.
		}

		ArmaParaAstrumAureus: {
			Titulo: Un arma capaz de defensa alta
			Porque: Astrum Aureus tiene 40 de defensa (mas que cualquier opcional anterior de Calamity) y 75000-120000 de vida, en la Infeccion Astral - el bioma que va apareciendo solo en Modo Dificil.
			Como: El Fragmento Astral lo invoca dentro de la Infeccion Astral.
		}

		VencerAAstrumAureus: {
			Titulo: Derrotarlo (opcional)
			Porque: No bloquea nada obligatorio por sí solo, aunque te adelanta materiales útiles para el resto de hardmode. No lo confundas con Astrum Deus (más adelante, y ese sí casi obligatorio): dos monstruos distintos que solo comparten nombre.
			Como: Su defensa alta hace que un arma floja se note mucho: si los golpes parecen no hacer nada, es la defensa, no que juegues mal.
		}

		ArmaParaCalamitasClone: {
			Titulo: Un arma a la altura de Plantera
			Porque: Calamitas Clone tiene 25 de defensa y 30000-46875 de vida - la propia wiki la sitúa "a un nivel similar a Plantera", recomendada tras los tres jefes mecanicos.
			Como: El Ojo de la Desolacion la invoca en cualquier sitio.
		}

		VencerACalamitasClone: {
			Titulo: Derrotarlo (opcional)
			Porque: No bloquea nada obligatorio, pero deja equipo a la altura de Plantera - vale la pena afrontarlo en la misma franja. No lo confundas con Supreme Calamitas, un jefe final completamente distinto que espera mucho más adelante, pese al nombre casi idéntico.
			Como: Dispara aros de fuego que cubren casi toda la pantalla: mira los huecos en el patron antes de que se cierre, no intentes esquivar dentro de el.
		}

		ArmaParaGreatSandShark: {
			Titulo: Un arma capaz de un miniboss post-Plantera
			Porque: Great Sand Shark es un miniboss opcional del Desierto, pensado para despues de Plantera.
			Como: El Nucleo de Tormenta de Arena lo invoca en el Desierto, o mata 10 tiburones de arena durante una tormenta para que aparezca solo.
		}

		VencerAGreatSandShark: {
			Titulo: Derrotarlo (opcional)
			Porque: No bloquea nada obligatorio: un depredador extra que el Desierto esconde para quien vuelva por esa zona después de Plantera.
			Como: Nada rapido bajo la arena y sale a embestir: quedarte en el aire, fuera de la arena, lo obliga a saltar hacia ti en vez de perseguirte a ciegas.
		}

		ArmaParaRavager: {
			Titulo: Un arma pensada para el nivel del Golem
			Porque: Ravager tiene 55 de defensa y 30000-54000 de vida - la propia wiki lo describe como "pensado en dificultad para estar a la altura del Golem", aunque se puede invocar antes si tienes valor.
			Como: El Silbato de la Muerte lo invoca en cualquier sitio. Se fabrica en un Altar Demoníaco o Carmesí con 25 Ladrillos de lihzahrd y 15 Fragmentos de tablilla solar, los que sueltan los Lihzahrd y las Serpientes voladoras del Templo.
		}

		VencerARavager: {
			Titulo: Derrotarlo (opcional)
			Porque: No bloquea nada obligatorio, pero es la puerta de entrada a la Plaga que empieza a cubrir la Jungla después del Golem - vale la pena antes de ir a por Plaguebringer Goliath.
			Como: Sus cuatro partes (cabeza, cuerpo, dos garras) atacan por separado: concentra el daño en la cabeza, el resto pierde fuerza cuando cae.
		}

		ArmaParaPlaguebringer: {
			Titulo: Un arma capaz de un jefe post-Golem
			Porque: The Plaguebringer Goliath tiene 50 de defensa y 70000-105000 de vida - la propia wiki la describe como "la fuerza central de la plaga que se instala en la Jungla tras la derrota del Golem".
			Como: El Abombination la invoca en la Jungla o Jungla subterranea.
		}

		VencerAPlaguebringer: {
			Titulo: Derrotarlo (opcional)
			Porque: No bloquea nada obligatorio, pero suelta las riendas del resto de la Plaga sobre la Jungla -enemigos y recursos nuevos- para lo que queda de hardmode.
			Como: Alterna fases de vuelo y de tierra con ataques muy distintos: no asumas que el patron que ya viste sigue valiendo al cambiar de fase.
		}

		ArmaParaDragonfolly: {
			Titulo: Un arma del nivel de justo tras la luna
			Porque: Dragonfolly tiene 40 de defensa y 150000-225000 de vida - la propia wiki lo situa "pensado para pelearse poco despues de derrotar al Señor de la Luna", aunque ya se puede desde el Cultista.
			Como: El Feromona Exotica lo invoca en la Jungla.
		}

		VencerADragonfolly: {
			Titulo: Derrotarlo (opcional)
			Porque: No bloquea nada obligatorio: un opcional de la franja posterior a la luna, pensado para asomarte justo después del Señor de la Luna aunque nada te obliga a ello.
			Como: Vuela erraticamente por toda la pantalla y suelta huevos que eclosionan en enemigos menores: revienta los huevos rapido antes de que se acumulen.
		}

		ArmaParaPrimordialWyrm: {
			Titulo: Un arma de nivel muy avanzado de postgame
			Porque: El Primordial Wyrm carga entre 2.500.000 y 3.000.000 de vida, 100 de defensa en la cabeza con un 40% de reducción de daño extra, y 42 segmentos de cuerpo que no reciben daño: solo cuenta la cabeza. Es un secreto de postgame del nivel de Supreme Calamitas y los Exo Mechs, y se enfurece fuera de la cuarta capa del Abismo.
			Como: No tiene objeto de invocación: aparece encima de ti cuando estás en el Abismo con el Estado caótico activo - el debuff que deja la Vara de la discordia al teletransportarte. Baja hasta la cuarta capa antes de provocarlo.
		}

		VencerAPrimordialWyrm: {
			Titulo: Derrotarlo (opcional, secreto)
			Porque: No bloquea nada obligatorio: es un secreto de postgame muy avanzado, de los que casi nadie llega a ver, y no exige haber derrotado a Polterghast ni a nadie más - solo bajar al Abismo con el Estado caótico encima.
			Como: Solo la cabeza recibe daño y en su última fase se vuelve inmune a casi todas las ralentizaciones y congelaciones: equipo completo de fin de partida, curación abundante y un arma que castigue un solo objetivo.
		}

		PrepararLluviaAcida3: {
			Titulo: Estar listo para la Lluvia Acida (fase 3)
			Porque: Mauler y Nuclear Terror son los dos minibosses de la fase 3 del evento Lluvia Ácida - la que abre la bandera de Polterghast derrotado (170 enemigos para un jugador), la misma fase en la que The Old Duke aparece al llegar al final del evento.
			Como: La Lluvia Acida empieza sola o con una Lagrima Caustica; con Polterghast ya derrotado, la fase 3 puede llegar a soltar cualquiera de los dos.
		}

		VencerALluviaAcida3: {
			Titulo: Derrotar a cualquiera de los dos (opcional)
			Porque: Ninguno de los dos bloquea nada obligatorio: son los minibosses que trae la fase final de la Lluvia Ácida, del mismo calibre que Old Duke y el Devourer of Gods.
			Como: Los dos son mucho más rápidos y agresivos que Cragmaw Mire: mantener movilidad constante importa más que buscar el hueco perfecto.
		}

		PrepararAstrumDeus: {
			Titulo: Un arma capaz del jefe que abre el mineral Astral
			Porque: Astrum Deus tiene 20 de defensa y 150000-240000 de vida. La Calamity Mod Wiki confirma que "debe ser derrotado para poder minar el Mineral Astral" y que esta pensado para justo despues del Cultista Lunatico, antes del Señor de la Luna.
			Como: Coloca un Faro Astral (mueble) y haz clic derecho de noche con un Corazon de Titan o un Nucleo Estelar en el inventario para invocarlo - no es un objeto que se "use" directamente.
		}

		VencerAAstrumDeus: {
			Titulo: Derrotarlo
			Porque: Con él caído, el Mineral Astral por fin se puede minar - un material real de progresión, no solo un trofeo. Es lo más cerca que tiene Calamity de exigirte algo antes del Señor de la Luna, aunque técnicamente se puede seguir sin él.
			Como: Es un gusano largo con dos cabezas independientes: cada una cuenta aparte para el daño total, como el Devorador de Mundos pero con doble frente.
		}

		ArmaParaGuardianes: {
			Titulo: Un arma capaz de tres guardianes a la vez
			Porque: Los Profaned Guardians son tres jefes que luchan JUNTOS. La wiki confirma que "hace falta matarlos para conseguir el Profaned Core, que invoca a Providence" - el unico requisito de invocacion realmente DURO de todo el postgame de Calamity.
			Como: El Fragmento Profano los invoca en el Sagrado o el Infierno.
		}

		VencerAGuardianes: {
			Titulo: Derrotarlos
			Porque: Con los tres en el suelo, te dejan el Profaned Core: la ÚNICA llave real para invocar a Providence - sáltate este paso y no hay otra forma de llegar hasta ella.
			Como: Los tres se potencian entre si: el Comandante es el mas resistente, pero centrarte solo en el deja vivos a los otros dos disparando sin parar.
		}

		ArmaParaProvidence: {
			Titulo: Un arma de nivel final de Calamity
			Porque: Providence, the Profaned Goddess tiene 50 de defensa y 250000-375000 de vida - el verdadero arranque del postgame de Calamity, justo despues del Señor de la Luna en la progresion real (no antes, pese a lo que sugiere de memoria el nombre "Goddess").
			Como: El Nucleo Profano (el drop de los Guardianes) la invoca en el Sagrado o el Infierno.
		}

		VencerAProvidence: {
			Titulo: Derrotarla
			Porque: Con ella caída, se abre el resto del postgame de Calamity: deja el Mark of Providence, la marca que invoca a Ceaseless Void, Storm Weaver y Signus - muy recomendable hacerlo antes de plantarles cara a esos tres, aunque nada te lo impide si decides saltártelo.
			Como: Cambia de fase segun su propio daño acumulado, no segun el tuyo: cada fase tiene un patron de proyectiles distinto, y todas se pueden repetir si la pierdes de vuelta a la anterior.
		}

		ArmaParaCeaselessVoid: {
			Titulo: Un arma de nivel postgame
			Porque: Ceaseless Void tiene 80 de defensa y 50000-78000 de vida - de los tres jefes que abre Providence, el que menos vida tiene pero mas defensa.
			Como: El Mark of Providence (lo suelta Providence la primera vez, y también se fabrica) invoca a uno de los tres según dónde lo uses: a Ceaseless Void dentro de la Mazmorra. Muy recomendado hacerlo tras Providence, aunque técnicamente no lo exige.
		}

		VencerACeaselessVoid: {
			Titulo: Derrotarlo
			Porque: Junto a Storm Weaver y Signus, dejarlo atrás allana el terreno para Polterghast - muy recomendable, aunque nada te obliga a pasar por aquí antes.
			Como: Crea un agujero negro central que atrae proyectiles: usalo a tu favor para limpiar el area en vez de solo esquivarlo.
		}

		ArmaParaStormWeaver: {
			Titulo: Un arma capaz de un gusano de defensa muy alta
			Porque: Storm Weaver tiene 150 de defensa - la mas alta de todo este tramo, muy por delante de Ceaseless Void (80) y Signus (60).
			Como: El Mark of Providence lo invoca en el cielo/espacio.
		}

		VencerAStormWeaver: {
			Titulo: Derrotarlo
			Porque: Junto a Ceaseless Void y Signus, dejarlo atrás allana el terreno para Polterghast. Storm Weaver y Signus comparten algo más que el vecindario -están relacionados de verdad- aunque enfrentarte a uno no te exige haber tumbado al otro.
			Como: Es un gusano segmentado volador: como con Aquatic Scourge, un arma de area rinde mas que apuntar a un solo segmento.
		}

		ArmaParaSignus: {
			Titulo: Un arma equilibrada para el tercero del trio
			Porque: Signus, Envoy of the Devourer tiene 60 de defensa y 250000-380000 de vida - el tercero de los jefes que abre Providence.
			Como: El Mark of Providence lo invoca en el Infierno.
		}

		VencerASignus: {
			Titulo: Derrotarlo
			Porque: Con él caído, se cierra el trío que Providence dejó abierto. Con los tres en el suelo -este, Ceaseless Void y Storm Weaver- llevas encima el mejor equipo posible antes de Polterghast, aunque de nuevo ninguno de los tres es un requisito estricto para seguir.
			Como: Se teletransporta sin parar por toda la pantalla dejando estelas cosmicas: no persigas la estela, anticipa donde va a reaparecer.
		}

		ArmaParaPolterghast: {
			Titulo: Un arma de nivel muy avanzado de postgame
			Porque: Polterghast tiene 90 de defensa y 280000-420000 de vida. La wiki confirma que se puede pelear antes de cualquier jefe postgame, pero que "se recomienda muchisimo" derrotar antes a Storm Weaver, Ceaseless Void y Signus.
			Como: La primera vez hace falta matar 30 Phantom Spirits dentro de la Mazmorra (ya en postgame) para que aparezca. Despues, el Necroplasmic Beacon lo repite directamente.
		}

		VencerAPolterghast: {
			Titulo: Derrotarlo
			Porque: Con él caído, la Lluvia Ácida desata su tercera fase (Mauler, Nuclear Terror y The Old Duke), y es un paso recomendado antes de ir a por Old Duke o el Devourer of Gods.
			Como: Se vuelve intangible por fases y solo se puede golpear en ciertos momentos: guarda tus ataques mas fuertes para cuando este solido de verdad.
		}

		ArmaParaOldDuke: {
			Titulo: Un arma de nivel avanzado de postgame
			Porque: The Old Duke tiene 90 de defensa y 400000-600000 de vida - convive con el Duque Pezhongo de vanilla, no lo sustituye (confirmado: comparten estilo de pelea pero son NPC distintos). La wiki lo situa textualmente "entre Polterghast y The Devourer of Gods".
			Como: Aparece en la fase 3 de la Lluvia Acida (tras Polterghast), o pescando con un Bloodworm en el Sulphurous Sea ya en postgame.
		}

		VencerAOldDuke: {
			Titulo: Derrotarlo
			Porque: Se recomienda dejarlo en el fondo del mar antes de ir a por el Devourer of Gods, aunque el juego no te obliga a seguir ese orden.
			Como: Cambia de forma varias veces durante la pelea, cada una con ataques distintos: no bajes la guardia entre transformaciones, el cambio en si no da tregua.
		}

		ArmaParaDoG: {
			Titulo: Un arma de nivel final de Calamity
			Porque: The Devourer of Gods tiene 50 de defensa pero 750000-900000 de vida - mas del doble que Polterghast. La wiki confirma que esta "pensado para pelearse despues de Storm Weaver, Ceaseless Void, Signus y Polterghast".
			Como: El Cosmic Worm lo invoca en cualquier sitio.
		}

		VencerADoG: {
			Titulo: Derrotarlo
			Porque: Con él caído, se abren las Barras de Cosmilite: un material real que necesitas para gran parte del equipo de final de partida, no un simple trofeo para presumir.
			Como: Es el gusano mas largo y rapido de todo el arbol: un arma de area con buen alcance importa mas aqui que en cualquier otro segmentado anterior.
		}

		ArmaParaYharon: {
			Titulo: Un arma capaz del penultimo tramo de Calamity
			Porque: Yharon, Dragon of Rebirth tiene 90 de defensa y 1000000-1560000 de vida - casi el doble que el Devourer of Gods. La wiki confirma que esta "pensado para pelearse despues de The Devourer of Gods".
			Como: El Huevo de Yharon lo invoca: se fabrica en el Manipulador antiguo con 10 Aleaciones de vida y 15 Plumas fulgentes, y esas plumas las suelta Dragonfolly (o sus crías salvajes), así que Dragonfolly es en la práctica su requisito. Invócalo en la Jungla: se enfurece si sales de ella.
		}

		VencerAYharon: {
			Titulo: Derrotarlo
			Porque: Con él caído, se abre paso al último tramo de todo Calamity: los Exo Mechs y Supreme Calamitas, dos amenazas pensadas para afrontarse casi a la vez.
			Como: Se cura si le dejas demasiado tiempo entre fases sin bajarle mas vida: manten la presion constante en vez de repartir el daño con pausas largas.
		}

		ArmaParaExoMechs: {
			Titulo: El arma mas fuerte que tengas
			Porque: Los Exo Mechs se luchan JUNTOS bajo el control de Draedon, en una batalla de varias fases - tu eliges por cual empezar, los otros dos se suman despues.
			Como: Se construye "El Descifrador" (Decryption Computer + Celula de Enfriamiento Cuantico Aurica) y se habla con Draedon para empezar - no es un objeto que se use directamente.
		}

		VencerAExoMechs: {
			Titulo: Derrotar a los tres
			Porque: Se da la batalla por ganada en cuanto cae el primero de los tres mechs, porque los tres luchan juntos desde el principio - en la práctica, acabas con los tres en la misma sesión de combate.
			Como: Cada mech tiene su propio patron: Ares dispara laseres fijos, Thanatos es un gusano volador, Artemis y Apollo cazan en pareja. Aprende los tres antes de intentarlo, aparecen juntos.
		}

		ArmaParaSupremeCalamitas: {
			Titulo: El arma final de todo el arbol
			Porque: Supreme Witch, Calamitas tiene 100 de defensa y 750000-1150000 de vida. La propia wiki la describe como que "actúa actualmente como jefe final junto a los Exo Mechs" - distinta de Calamitas Clone (mucho más temprana, nivel Plantera).
			Como: Las Cenizas de Calamidad se usan en el Altar de los Malditos para invocarla.
		}

		VencerASupremeCalamitas: {
			Titulo: Derrotarla: el final del arbol de Calamity
			Porque: Con ella caída, se cierra todo el árbol de Calamity tal y como está hoy - junto a los Exo Mechs, el propio mod la trata como su final de verdad.
			Como: Cambia de fase con patrones muy distintos entre si: no hay un truco unico que valga para toda la pelea, cada fase exige su propia lectura.
		}
	}
}

